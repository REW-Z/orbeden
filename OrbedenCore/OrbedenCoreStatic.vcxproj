    <IntDir>$(MSBuildProjectDirectory)\obj\Static\$(Configuration)\</IntDir>
    <TargetName>OrbedenCoreStatic</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalOptions>/utf-8 /EHsc %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>ORBEDEN_PLAYER;PX_PHYSX_STATIC_LIB;DISABLE_CUDA_PHYSX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory)\Src;$(MSBuildProjectDirectory)\Src\ThirdParty\PhysX\include;$(MSBuildProjectDirectory)\Src\ThirdParty\glfw\include;$(MSBuildProjectDirectory)\Src\ThirdParty\glad\include;$(MSBuildProjectDirectory)\Src\ThirdParty\imgui;$(MSBuildProjectDirectory)\Src\ThirdParty\imgui\backends;$(MSBuildProjectDirectory)\Src\ThirdParty\cgltf;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
