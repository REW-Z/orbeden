    <ClCompile Include="Src\**\*.c" />
  </ItemGroup>
  <Target Name="GenerateCoreBindings" BeforeTargets="ClCompile">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\OrbedenEditor\Sdk\Tools\OrbedenMetaGen\OrbedenMetaGen.dll')" Text="Orbeden SDK MetaGen was not found. Build OrbedenCore first." />
