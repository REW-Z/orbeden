<Project>
  <!--
    Orbeden.UI 包的源码接入点。整包有一个唯一来源，由 Orbeden.Bindings.targets 决定：
    项目内 <Project>/Packages/Orbeden.UI/ 优先，不存在时用 SDK 的 Sdk/Packages/Orbeden.UI/。
    本文件只声明 Compile 项，来源判定与版本校验都在调用方完成，因此两个来源不会同时生效。

    Runtime 进游戏主程序集，Editor 进 <Game>.Editor。
    Runtime 不得引用 Orbeden.Editor；Editor 源码不参与 Player/AOT。
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Runtime/**/*.cs" />
    <!--编辑器源码与内容根的 Editor 源码同属 <Game>.Editor，共用同一个收集项。-->
    <OrbedenEditorSource Include="$(MSBuildThisFileDirectory)Editor/**/*.cs" />
  </ItemGroup>
  <PropertyGroup>
    <OrbedenUIEditorPackageRoot>$(MSBuildThisFileDirectory)Editor</OrbedenUIEditorPackageRoot>
  </PropertyGroup>
</Project>
