<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{8B2F6D41-9C5A-4E7B-8A3D-1F6E2C9B7A50}</ProjectGuid>
    <RootNamespace>OrbedenGame</RootNamespace>
    <!--Player 工程位于 OrbedenGame/ 下，仓库根为上一级目录。-->
    <OrbedenEngineRoot Condition="'$(OrbedenEngineRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))</OrbedenEngineRoot>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <UseDebugLibraries>true</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <OutDir>$(MSBuildProjectDirectory)\Build\windows-x64\bin\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\Build\windows-x64\obj\</IntDir>
    <TargetName>OrbedenGame</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalOptions>/utf-8 /EHsc %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>WIN32;_CONSOLE;ORBEDEN_PLAYER;PX_PHYSX_STATIC_LIB;DISABLE_CUDA_PHYSX;ORBEDEN_HAS_NATIVE_GAME;ORBEDEN_PROJECT_DIR="$(OrbedenProjectDir.Replace('\', '/'))";%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(OrbedenEngineRoot)\OrbedenCore\Src;$(OrbedenEngineRoot)\OrbedenCore\Src\ThirdParty\PhysX\include;$(OrbedenEngineRoot)\OrbedenCore\Src\ThirdParty\glfw\include;$(OrbedenEngineRoot)\OrbedenCore\Src\ThirdParty\glad\include;$(OrbedenEngineRoot)\OrbedenCore\Src\ThirdParty\imgui;$(OrbedenEngineRoot)\OrbedenCore\Src\ThirdParty\imgui\backends;$(OrbedenEngineRoot)\OrbedenCore\Src\ThirdParty\cgltf;$(OrbedenEngineRoot)\OrbedenGame\Src;$(OrbedenProjectDir)\Native;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalDependencies>$(OrbedenEngineRoot)\OrbedenCore\Src\ThirdParty\PhysX\lib\WindowsX64\$(Configuration)\PhysX_static_64.lib;$(OrbedenEngineRoot)\OrbedenCore\Src\ThirdParty\PhysX\lib\WindowsX64\$(Configuration)\PhysXCommon_static_64.lib;$(OrbedenEngineRoot)\OrbedenCore\Src\ThirdParty\PhysX\lib\WindowsX64\$(Configuration)\PhysXFoundation_static_64.lib;$(OrbedenEngineRoot)\OrbedenCore\Src\ThirdParty\PhysX\lib\WindowsX64\$(Configuration)\PhysXExtensions_static_64.lib;$(OrbedenEngineRoot)\OrbedenCore\Src\ThirdParty\PhysX\lib\WindowsX64\$(Configuration)\PhysXPvdSDK_static_64.lib;$(OrbedenEngineRoot)\OrbedenCore\Src\ThirdParty\PhysX\lib\WindowsX64\$(Configuration)\PhysXCooking_static_64.lib;$(OrbedenEngineRoot)\OrbedenCore\Src\ThirdParty\PhysX\lib\WindowsX64\$(Configuration)\PhysXCharacterKinematic_static_64.lib;$(OrbedenEngineRoot)\OrbedenCore\Src\ThirdParty\PhysX\lib\WindowsX64\$(Configuration)\PhysXVehicle_static_64.lib;$(OrbedenEngineRoot)\OrbedenCore\Src\ThirdParty\glfw\lib-vc2022\glfw3_mt.lib;$(OrbedenGameAotLib);opengl32.lib;gdi32.lib;user32.lib;shell32.lib;advapi32.lib;ole32.lib;uuid.lib;dwmapi.lib;winmm.lib;imm32.lib;version.lib;setupapi.lib;ws2_32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent Condition="'$(OrbedenGameAotDll)' != ''">
      <Command>copy /Y &quot;$(OrbedenGameAotDll)&quot; &quot;$(OutDir.TrimEnd('\'))&quot;</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Src\game_main.cpp" />
    <ClCompile Include="..\OrbedenCore\Src\**\*.cpp" Exclude="..\OrbedenCore\Src\examples.cpp;..\OrbedenCore\Src\ThirdParty\imgui\backends\imgui_impl_opengl3.cpp;..\OrbedenCore\Src\ThirdParty\imgui\backends\imgui_impl_vulkan.cpp" />
    <ClCompile Include="..\OrbedenCore\Src\**\*.c" />
    <ClCompile Include="$(OrbedenProjectDir)\Native\*.cpp" Exclude="$(OrbedenProjectDir)\Native\GameModule.cpp;$(OrbedenProjectDir)\Native\Build\**\*.cpp" />
    <!--游戏生成的 .cpp 与 Core 生成文件同名，使用独立 obj 目录避免冲突。-->
    <ClCompile Include="$(OrbedenProjectDir)\Native\Generated\*.cpp">
      <ObjectFileName>$(IntDir)GameGenerated\%(Filename).obj</ObjectFileName>
    </ClCompile>
    <ClInclude Include="Src\*.h" />
  </ItemGroup>
  <Target Name="GenerateCoreBindings" BeforeTargets="ClCompile">
    <Exec Command="dotnet &quot;$(OrbedenEngineRoot)\OrbedenEditor\Sdk\Tools\OrbedenMetaGen\OrbedenMetaGen.dll&quot; &quot;$(OrbedenEngineRoot)\OrbedenCore\Src&quot; &quot;$(OrbedenEngineRoot)\OrbedenCore\Src\Runtime\Generated&quot; --bindings" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
