<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    游戏原生模块的共享配置，由 Orbeden SDK 发布到 Sdk/Native/ 后由游戏工程导入。
    不要修改游戏工程里的副本：这里是唯一来源，引擎侧改动随 SDK 一起刷新。

    导入位置必须在 Microsoft.Cpp.Default.props 之后、Microsoft.Cpp.props 之前：
    后者按 $(PlatformToolset) 去导入对应工具集的属性表。
    构建设置（include、link、源文件收集、绑定生成目标）在 Orbeden.Native.targets 中，
    那份必须在 Microsoft.Cpp.props 之后才能压过工具集默认值。
  -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <UseDebugLibraries>true</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup>
    <!--工程文件直接放在项目根，工程根就是 MSBuildProjectDirectory。-->
    <OrbedenProjectRoot Condition="'$(OrbedenProjectRoot)' == ''">$(MSBuildProjectDirectory)</OrbedenProjectRoot>
    <!--
      游戏名从工程文件名推导：原生工程约定叫 <项目名>Native.vcxproj。
      这样工程文件不必写项目名，模板里也就没有占位符。正则锚定结尾，
      工程名不含该后缀时原样返回，不会被误伤。
      推导结果必须与 C# 侧 $(RootNamespace)（默认是 csproj 基名）一致，
      否则两边传给 MetaGen 的 namespace 参数不同，游戏脚本引用绑定类型会编译不过。
    -->
    <OrbedenGameName Condition="'$(OrbedenGameName)' == ''">$([System.Text.RegularExpressions.Regex]::Replace('$(MSBuildProjectName)', 'Native$', ''))</OrbedenGameName>
    <OrbedenBindingNamespace>$(OrbedenGameName).Native</OrbedenBindingNamespace>
    <!--内容根：美术、音频、场景与代码脚本，内部结构完全自由。-->
    <OrbedenContentRoot>$(OrbedenProjectRoot)\Content</OrbedenContentRoot>
    <!--原生模块的全部产物，内容根之外。-->
    <OrbedenNativeBuildDir>$(OrbedenProjectRoot)\Build\Native</OrbedenNativeBuildDir>
    <!--生成源码所在目录：编辑器与 MetaGen 都按这个固定位置取用。-->
    <OrbedenGeneratedDir>$(OrbedenNativeBuildDir)\Generated</OrbedenGeneratedDir>
    <!--
      输出目录必须在 Microsoft.Cpp.targets 之前设定：TargetPath 在求值阶段就由
      $(OutDir)$(TargetName)$(TargetExt) 算好，晚了会退回默认的 x64\<Configuration>。
      Editor 按 Build/Native/<项目名>Native.dll 加载模块，这个路径必须稳定。
    -->
    <OutDir>$(OrbedenNativeBuildDir)\</OutDir>
    <IntDir>$(OrbedenNativeBuildDir)\obj\</IntDir>
    <TargetExt>.dll</TargetExt>
  </PropertyGroup>
</Project>
