--------frag
#ifndef ORBEDEN_ATMOSPHERE_SAMPLING_INCLUDED
#define ORBEDEN_ATMOSPHERE_SAMPLING_INCLUDED

#include "Builtin/atmosphere_common.orbinc"

//表面片元的空气透视与浓雾合成。两者是各自独立的功能，各看各的开关：
//空气透视在近地图集与逐像素散射积分间切换，浓雾按高度剖面解析积分。
//宿主 Shader 需要声明 uniform vec3 u_CameraPosition; 本文件与 shadow_common 依赖 u_LightDirection 同理。

uniform sampler2D u_AtmosphereRadianceTexture;
uniform sampler2D u_AtmosphereOpticalDepthTexture;
uniform int u_AtmosphereFogEnabled;
uniform float u_AtmosphereMaxDistanceKm;
uniform float u_AtmosphereMetersPerWorldUnit;
uniform vec4 u_AtmosphereViewport;
//(节点宽, 节点高, 距离层数, 图集列数)
uniform vec4 u_AtmosphereAtlas;
uniform float u_AtmosphereCameraHeightKm;
uniform vec3 u_AtmosphereCameraUp;
uniform mat4 u_AtmosphereInverseProjection;
uniform vec3 u_AtmosphereSunDirection;
uniform vec4 u_AtmosphereSunRadiance;
uniform float u_AtmosphereAerosolDensity;
uniform int u_AtmosphereTraceStepCount;

//浓雾函数引用上面两个相机 uniform，必须声明之后才能展开
#include "Builtin/dense_fog.orbinc"

//一个采样点的散射亮度与透光率
struct AtmosphereSample
{
    vec3 radiance;
    vec3 transmittance;
};

//取当前片元的屏幕坐标，坐标原点与场景目标一致
vec2 GetAtmosphereScreenUv()
{
    return gl_FragCoord.xy / max(u_AtmosphereViewport.xy, vec2(1.0));
}

//读取图集中一个距离层的整数节点
void ReadAerialNode(float layer, ivec2 node, out vec3 radiance, out vec3 tau)
{
    int columns = int(u_AtmosphereAtlas.w);
    ivec2 size = ivec2(u_AtmosphereAtlas.xy);
    int slice = int(layer);
    ivec2 pixel = ivec2(slice % columns, slice / columns) * size + node;
    radiance = texelFetch(u_AtmosphereRadianceTexture, pixel, 0).rgb;
    tau = texelFetch(u_AtmosphereOpticalDepthTexture, pixel, 0).rgb;
}

//按统一距离坐标查询单个空气透视节点
void SampleAerialNode(ivec2 node, float distanceKm, out vec3 radiance, out vec3 tau)
{
    radiance = vec3(0.0);
    tau = vec3(0.0);
    float z = GetAerialSampleFraction(distanceKm, u_AtmosphereMaxDistanceKm) * (u_AtmosphereAtlas.z - 1.0);
    float lower = floor(z);
    float upper = min(lower + 1.0, u_AtmosphereAtlas.z - 1.0);
    vec3 nearRadiance;
    vec3 nearTau;
    vec3 farRadiance;
    vec3 farTau;
    ReadAerialNode(lower, node, nearRadiance, nearTau);
    ReadAerialNode(upper, node, farRadiance, farTau);
    //按层间消光积分插值散射亮度
    float fraction = z - lower;
    vec3 deltaTau = max(farTau - nearTau, vec3(0.0));
    vec3 attenuation = vec3(1.0) - exp(-deltaTau);
    vec3 weight = mix(vec3(fraction), (vec3(1.0) - exp(-fraction * deltaTau)) / max(attenuation, vec3(1.0e-5)),
        step(vec3(1.0e-5), attenuation));
    radiance = mix(nearRadiance, farRadiance, weight);
    tau = mix(nearTau, farTau, fraction);
}

//合成近地图集与逐像素空气透视
AtmosphereSample SampleAerialPerspective(vec2 uv, float distanceKm, vec3 ray)
{
    AtmosphereSample result;
    result.radiance = vec3(0.0);
    result.transmittance = vec3(1.0);
    if (u_AtmosphereFogEnabled == 0 || distanceKm <= 0.0)
    {
        return result;
    }

    //按高度、距离与地平线邻域选择积分路径
    float height = max(u_AtmosphereCameraHeightKm, 0.0);
    float horizon = -sqrt(height * (2.0 * AtmosphereGroundRadius + height)) / (AtmosphereGroundRadius + height);
    float mu = clamp(dot(u_AtmosphereCameraUp, ray), -1.0, 1.0);
    vec2 nodeAngle = 2.0 * vec2(abs(u_AtmosphereInverseProjection[0][0]), abs(u_AtmosphereInverseProjection[1][1]))
        / (u_AtmosphereAtlas.xy - 1.0);
    float band = max(nodeAngle.x, nodeAngle.y);
    float horizonOffset = abs(asin(mu) - asin(horizon));
    float traceWeight = max(smoothstep(8.0, 16.0, height),
        smoothstep(u_AtmosphereMaxDistanceKm * 0.75, u_AtmosphereMaxDistanceKm, distanceKm));
    traceWeight = max(traceWeight, 1.0 - smoothstep(band, 2.0 * band, horizonOffset));

    //读取同一距离上的四个近地节点
    vec3 opticalDepth = vec3(0.0);
    if (traceWeight < 1.0)
    {
        ivec2 maximum = ivec2(u_AtmosphereAtlas.xy) - 1;
        vec2 coordinate = clamp(uv, 0.0, 1.0) * vec2(maximum);
        ivec2 lower = ivec2(floor(coordinate));
        ivec2 upper = min(lower + 1, maximum);
        vec2 fraction = fract(coordinate);
        vec3 radiance[4];
        vec3 tau[4];
        SampleAerialNode(lower, distanceKm, radiance[0], tau[0]);
        SampleAerialNode(ivec2(upper.x, lower.y), distanceKm, radiance[1], tau[1]);
        SampleAerialNode(ivec2(lower.x, upper.y), distanceKm, radiance[2], tau[2]);
        SampleAerialNode(upper, distanceKm, radiance[3], tau[3]);
        result.radiance = mix(mix(radiance[0], radiance[1], fraction.x), mix(radiance[2], radiance[3], fraction.x), fraction.y);
        opticalDepth = mix(mix(tau[0], tau[1], fraction.x), mix(tau[2], tau[3], fraction.x), fraction.y);
    }

    //按实际片元视线积分并混合过渡区域
    if (traceWeight > 0.0)
    {
        vec3 radiance;
        vec3 tau;
        IntegrateAtmosphere(u_AtmosphereCameraHeightKm, u_AtmosphereCameraUp, ray, distanceKm,
            u_AtmosphereTraceStepCount, 0, u_AtmosphereAerosolDensity,
            u_AtmosphereSunRadiance.rgb, u_AtmosphereSunDirection, radiance, tau);
        result.radiance = mix(result.radiance, radiance, traceWeight);
        opticalDepth = mix(opticalDepth, tau, traceWeight);
    }
    result.transmittance = exp(-opticalDepth);
    return result;
}

//查询表面处的空气透视。需要分别处理两种介质（粒子、折射玻璃）的宿主用本函数与下面的浓雾版本。
AtmosphereSample SampleSurfaceAerial(vec3 worldPosition, vec2 screenUv)
{
    AtmosphereSample result;
    result.radiance = vec3(0.0);
    result.transmittance = vec3(1.0);
    if (u_AtmosphereFogEnabled == 0) return result;

    vec3 offset = worldPosition - u_CameraPosition;
    float distanceKm = length(offset) * u_AtmosphereMetersPerWorldUnit / 1000.0;
    if (distanceKm <= 0.0) return result;

    return SampleAerialPerspective(screenUv, distanceKm, offset / length(offset));
}

//给已着色的表面加上空气透视
vec3 ApplyAtmosphereToSurface(vec3 rgb, vec3 worldPosition, vec2 screenUv)
{
    AtmosphereSample aerial = SampleSurfaceAerial(worldPosition, screenUv);
    return rgb * aerial.transmittance + aerial.radiance;
}

//查询表面处的浓雾。与空气透视无关，只受浓雾自己的开关控制。
AtmosphereSample SampleSurfaceDenseFog(vec3 worldPosition)
{
    AtmosphereSample result;
    result.radiance = vec3(0.0);
    result.transmittance = vec3(1.0);
    if (u_AtmosphereDenseFogEnabled == 0) return result;

    vec3 offset = worldPosition - u_CameraPosition;
    float distanceKm = length(offset) * u_AtmosphereMetersPerWorldUnit / 1000.0;
    if (distanceKm <= 0.0) return result;

    SampleDenseFog(u_AtmosphereCameraHeightKm, u_AtmosphereCameraUp, normalize(offset), distanceKm,
        result.transmittance, result.radiance);
    return result;
}

//给已着色的表面叠加浓雾
vec3 ApplyDenseFogToSurface(vec3 rgb, vec3 worldPosition)
{
    AtmosphereSample fogSample = SampleSurfaceDenseFog(worldPosition);
    return rgb * fogSample.transmittance + fogSample.radiance;
}

//空气透视与浓雾一并叠加。顺序固定为「先空气透视，后浓雾」：
//浓雾是近场介质，叠在最外层；相机在雾层内时这与逐段积分一致。
//两种介质各自看自己的开关，都不看对方。
vec3 ApplySurfaceFog(vec3 rgb, vec3 worldPosition, vec2 screenUv)
{
    return ApplyDenseFogToSurface(ApplyAtmosphereToSurface(rgb, worldPosition, screenUv), worldPosition);
}

#endif
