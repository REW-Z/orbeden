--------frag
//表面片元的空气透视与浓雾合成。两者是各自独立的功能，各看各的开关：
//空气透视查面向远景的 L/Tau 图集，浓雾按高度剖面解析积分，互不引用对方的 uniform。
//宿主 Shader 需要声明 uniform vec3 u_CameraPosition; 本文件与 shadow_common 依赖 u_LightDirection 同理。

uniform sampler2D u_AtmosphereRadianceTexture;
uniform sampler2D u_AtmosphereOpticalDepthTexture;
uniform int u_AtmosphereFogEnabled;
uniform float u_AtmosphereMaxDistanceKm;
uniform float u_AtmosphereMetersPerWorldUnit;
uniform vec4 u_AtmosphereViewport;
//(节点宽, 节点高, 距离层数, 图集列数)
uniform vec4 u_AtmosphereAtlas;
uniform float u_AtmosphereCameraHeightKm;
uniform vec3 u_AtmosphereCameraUp;

//浓雾函数引用上面两个相机 uniform，必须声明之后才能展开
#include "Builtin/dense_fog.orbinc"

//一个采样点的散射亮度与透光率
struct AtmosphereSample
{
    vec3 radiance;
    vec3 transmittance;
};

//取当前片元的屏幕坐标，坐标原点与场景目标一致
vec2 GetAtmosphereScreenUv()
{
    return gl_FragCoord.xy / max(u_AtmosphereViewport.xy, vec2(1.0));
}

//取距离在层轴上的位置
float GetAerialSlice(float distanceKm)
{
    return log(1.0 + clamp(distanceKm, 0.0, u_AtmosphereMaxDistanceKm) / 0.01) /
        log(1.0 + u_AtmosphereMaxDistanceKm / 0.01) * (u_AtmosphereAtlas.z - 1.0);
}

//查询一个距离层的散射亮度与光学厚度
void SampleAerialLayer(float layer, vec2 uv, out vec3 radiance, out vec3 tau)
{
    float columns = u_AtmosphereAtlas.w;
    vec2 tile = u_AtmosphereAtlas.xy;
    vec2 origin = vec2(mod(layer, columns) * tile.x, floor(layer / columns) * tile.y);
    vec2 atlasSize = vec2(tile.x * columns, tile.y * (u_AtmosphereAtlas.z / columns));
    vec2 atlasUv = (origin + 0.5 + uv * (tile - 1.0)) / atlasSize;

    radiance = texture(u_AtmosphereRadianceTexture, atlasUv).rgb;
    tau = texture(u_AtmosphereOpticalDepthTexture, atlasUv).rgb;
}

//查询空气透视，距离以 km 计
AtmosphereSample SampleAerialPerspective(vec2 uv, float distanceKm)
{
    AtmosphereSample result;
    result.radiance = vec3(0.0);
    result.transmittance = vec3(1.0);
    if (u_AtmosphereFogEnabled == 0 || distanceKm <= 0.0) return result;

    //距离落在相邻两层之间，按层内小数插值
    float z = GetAerialSlice(distanceKm);
    float nearLayer = min(floor(z), u_AtmosphereAtlas.z - 1.0);
    float farLayer = min(nearLayer + 1.0, u_AtmosphereAtlas.z - 1.0);
    float sliceBlend = z - nearLayer;

    vec2 clampedUv = clamp(uv, vec2(0.0), vec2(1.0));
    vec3 nearRadiance = vec3(0.0);
    vec3 nearTau = vec3(0.0);
    vec3 farRadiance = vec3(0.0);
    vec3 farTau = vec3(0.0);
    SampleAerialLayer(nearLayer, clampedUv, nearRadiance, nearTau);
    SampleAerialLayer(farLayer, clampedUv, farRadiance, farTau);

    result.radiance = mix(nearRadiance, farRadiance, sliceBlend);
    result.transmittance = exp(-mix(nearTau, farTau, sliceBlend));
    return result;
}

//查询表面处的空气透视。需要分别处理两种介质（粒子、折射玻璃）的宿主用本函数与下面的浓雾版本。
AtmosphereSample SampleSurfaceAerial(vec3 worldPosition, vec2 screenUv)
{
    AtmosphereSample result;
    result.radiance = vec3(0.0);
    result.transmittance = vec3(1.0);
    if (u_AtmosphereFogEnabled == 0) return result;

    vec3 offset = worldPosition - u_CameraPosition;
    float distanceKm = length(offset) * u_AtmosphereMetersPerWorldUnit / 1000.0;
    if (distanceKm <= 0.0) return result;

    return SampleAerialPerspective(screenUv, distanceKm);
}

//给已着色的表面加上空气透视
vec3 ApplyAtmosphereToSurface(vec3 rgb, vec3 worldPosition, vec2 screenUv)
{
    AtmosphereSample aerial = SampleSurfaceAerial(worldPosition, screenUv);
    return rgb * aerial.transmittance + aerial.radiance;
}

//查询表面处的浓雾。与空气透视无关，只受浓雾自己的开关控制。
AtmosphereSample SampleSurfaceDenseFog(vec3 worldPosition)
{
    AtmosphereSample result;
    result.radiance = vec3(0.0);
    result.transmittance = vec3(1.0);
    if (u_AtmosphereDenseFogEnabled == 0) return result;

    vec3 offset = worldPosition - u_CameraPosition;
    float distanceKm = length(offset) * u_AtmosphereMetersPerWorldUnit / 1000.0;
    if (distanceKm <= 0.0) return result;

    SampleDenseFog(u_AtmosphereCameraHeightKm, u_AtmosphereCameraUp, normalize(offset), distanceKm,
        result.transmittance, result.radiance);
    return result;
}

//给已着色的表面叠加浓雾
vec3 ApplyDenseFogToSurface(vec3 rgb, vec3 worldPosition)
{
    AtmosphereSample fogSample = SampleSurfaceDenseFog(worldPosition);
    return rgb * fogSample.transmittance + fogSample.radiance;
}

//空气透视与浓雾一并叠加。顺序固定为「先空气透视，后浓雾」：
//浓雾是近场介质，叠在最外层；相机在雾层内时这与逐段积分一致。
//两种介质各自看自己的开关，都不看对方。
vec3 ApplySurfaceFog(vec3 rgb, vec3 worldPosition, vec2 screenUv)
{
    return ApplyDenseFogToSurface(ApplyAtmosphereToSurface(rgb, worldPosition, screenUv), worldPosition);
}
