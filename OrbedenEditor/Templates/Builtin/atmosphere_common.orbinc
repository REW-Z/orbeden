--------frag
//球形大气的球面数学、密度与单次散射积分。长度单位统一为 km，方向向量必须已归一化。
//密度只随距地心的高度变化，地形起伏不参与，因此所有函数都是径向对称的。

const float AtmospherePi = 3.141592653589793;
const float AtmosphereGroundRadius = 6371.0;
const float AtmosphereTopHeight = 100.0;
const float AtmosphereRayleighHeight = 8.0;
const float AtmosphereMieHeight = 1.2;
const vec3 AtmosphereRayleighScattering = vec3(0.005802, 0.013558, 0.033100);
const float AtmosphereMieScattering = 0.003996;
const float AtmosphereMieExtinction = 0.004440;
const float AtmosphereMieAnisotropy = 0.8;
//太阳盘的角半径，以弧度计
const float AtmosphereSunAngularRadius = 0.00465;
//积分循环的编译上限，超过 StepCount 的迭代在这里退出
const int AtmosphereMaxSteps = 64;

uniform sampler2D u_AtmosphereTransmittanceTexture;
uniform vec4 u_AtmosphereTransSize;

//取非零符号，避免求根时出现除以零
float AtmosphereSignNonzero(float value)
{
    return value < 0.0 ? -1.0 : 1.0;
}

//由起始高度与视线余弦求射线上的局部高度，近地时用该式避免直接相减丢精度
float ComputeAltitude(float h, float mu, float s)
{
    float q = h * (2.0 * AtmosphereGroundRadius + h) + 2.0 * s * (AtmosphereGroundRadius + h) * mu + s * s;
    return q / (sqrt(max(AtmosphereGroundRadius * AtmosphereGroundRadius + q, 0.0)) + AtmosphereGroundRadius);
}

//求射线与指定高度球面的两个交点，按 t0<=t1 返回
bool IntersectAtmosphereBoundary(float h, float mu, float hb, out float t0, out float t1)
{
    t0 = 0.0;
    t1 = 0.0;

    float b = (AtmosphereGroundRadius + h) * mu;
    float c = (h - hb) * (2.0 * AtmosphereGroundRadius + h + hb);
    float discriminant = b * b - c;
    if (discriminant < 0.0) return false;

    float root = -b - AtmosphereSignNonzero(b) * sqrt(max(discriminant, 0.0));
    float first = root != 0.0 ? root : -b;
    float second = root != 0.0 ? c / root : -b;
    t0 = min(first, second);
    t1 = max(first, second);
    return true;
}

//求射线与地球表面的首次交点距离，未命中时返回负值。
//相机低于参考球面时按海平面处理：模型的地面就是参考球面，球面以下不属于大气，
//向下看等于站在地面上看脚下，距离为零。这样跨过海平面时不会突然切换行为。
float IntersectGroundDistance(float h, float mu)
{
    float groundHeight = max(h, 0.0);

    //先用地平线余弦判断：近切线时判别式是相近量相减，直接比较余弦更稳
    float muHorizon = -sqrt(max(groundHeight * (2.0 * AtmosphereGroundRadius + groundHeight), 0.0)) /
        (AtmosphereGroundRadius + groundHeight);
    if (mu >= muHorizon) return -1.0;

    //地面就在起点：向下的射线从参考球面出发，没有前方交点
    if (groundHeight <= 0.0) return 0.0;

    float t0 = 0.0;
    float t1 = 0.0;
    if (!IntersectAtmosphereBoundary(groundHeight, mu, 0.0, t0, t1)) return 0.0;

    float ground = t0 >= 0.0 ? t0 : t1;
    return max(ground, 0.0);
}

//把视线裁剪到大气内。相机在大气外时起点是入射点，不经过大气时区间为空
void ClipAtmosphereSegment(float h, float mu, float distance, out float start, out float end)
{
    start = 0.0;
    end = max(distance, 0.0);

    float t0 = 0.0;
    float t1 = 0.0;
    if (!IntersectAtmosphereBoundary(h, mu, AtmosphereTopHeight, t0, t1) || t1 <= 0.0)
    {
        end = 0.0;
        return;
    }

    start = max(t0, 0.0);
    end = min(end, t1);

    //地球首次入口同样参与截断
    float ground = IntersectGroundDistance(h, mu);
    if (ground >= 0.0) end = min(end, ground);
    if (end < start) end = start;
}

//按高度取 Rayleigh 与 Mie 密度
vec2 EvaluateDensity(float h)
{
    if (h > AtmosphereTopHeight) return vec2(0.0);

    float altitude = max(h, 0.0);
    return vec2(exp(-altitude / AtmosphereRayleighHeight), exp(-altitude / AtmosphereMieHeight));
}

//按高度取散射与消光系数，Mie 部分随气溶胶密度缩放
void EvaluateScattering(float h, float aerosolDensity, out vec3 scatteringRayleigh, out vec3 scatteringMie, out vec3 extinction)
{
    vec2 density = EvaluateDensity(h);
    scatteringRayleigh = AtmosphereRayleighScattering * density.x;
    scatteringMie = vec3(AtmosphereMieScattering * aerosolDensity * density.y);
    extinction = scatteringRayleigh + vec3(AtmosphereMieExtinction * aerosolDensity * density.y);
}

//取 Rayleigh 与 Mie 相位函数，nu 为视线与太阳方向的余弦
vec2 EvaluatePhase(float nu)
{
    float rayleigh = 3.0 * (1.0 + nu * nu) / (16.0 * AtmospherePi);
    float mieDenominator = max(1.0 + AtmosphereMieAnisotropy * AtmosphereMieAnisotropy -
        2.0 * AtmosphereMieAnisotropy * nu, 0.0001);
    float mie = (1.0 - AtmosphereMieAnisotropy * AtmosphereMieAnisotropy) /
        (4.0 * AtmospherePi * pow(mieDenominator, 1.5));
    return vec2(rayleigh, mie);
}

//采样太阳（或任意向上方向）的光学厚度，太阳射线穿过地球时返回足够大的值。
//表里存的是光学厚度本身而不是 exp(-tau)：掠射射线的 tau 能到 20 上下，
//存 exp(-tau) 会在蓝通道下溢成 0（约 7e-9），凡是要做比值或相减的用法都会拿到错值
vec3 SampleSunOpticalDepth(float h, float mu)
{
    if (IntersectGroundDistance(h, mu) >= 0.0) return vec3(1.0e6);

    //反算查找表坐标：高度取平方分布，视线余弦在地平线到天顶之间取平方分布
    float altitude = clamp(h, 0.0, AtmosphereTopHeight);
    float v = sqrt(altitude / AtmosphereTopHeight);
    float muHorizon = -sqrt(max(altitude * (2.0 * AtmosphereGroundRadius + altitude), 0.0)) /
        (AtmosphereGroundRadius + altitude);
    float u = sqrt(clamp((mu - muHorizon) / (1.0 - muHorizon), 0.0, 1.0));

    vec2 uv = vec2(0.5 + u * (u_AtmosphereTransSize.x - 1.0), 0.5 + v * (u_AtmosphereTransSize.y - 1.0)) /
        u_AtmosphereTransSize.xy;
    return texture(u_AtmosphereTransmittanceTexture, uv).rgb;
}

//采样太阳透光率，太阳射线穿过地球时返回零
vec3 SampleSunTransmittance(float h, float mu)
{
    return exp(-SampleSunOpticalDepth(h, mu));
}

//天空查找表的地平线相对仰角映射：v = 0.5 对应地平线，两侧各占一半，
//靠地平线一端按平方加密。行数取偶数时地平线恰好落在节点行边界上，
//掠过地平线的陡变不会被双线性抹成跨越两行的一段斜坡
float AtmosphereSkyZenithCosFromUv(float v, float cameraHeightKm)
{
    float h = max(cameraHeightKm, 0.0);
    float muHorizon = -sqrt(max(h * (2.0 * AtmosphereGroundRadius + h), 0.0)) / (AtmosphereGroundRadius + h);
    float t = clamp(v * 2.0 - 1.0, -1.0, 1.0);
    float span = t >= 0.0 ? 1.0 - muHorizon : muHorizon + 1.0;
    return muHorizon + sign(t) * span * t * t;
}

//上面映射的反函数，天空着色器按像素的视线仰角反算表坐标
float AtmosphereSkyUvFromZenithCos(float mu, float cameraHeightKm)
{
    float h = max(cameraHeightKm, 0.0);
    float muHorizon = -sqrt(max(h * (2.0 * AtmosphereGroundRadius + h), 0.0)) / (AtmosphereGroundRadius + h);
    float offset = mu - muHorizon;
    float span = offset >= 0.0 ? 1.0 - muHorizon : muHorizon + 1.0;
    float t = sqrt(clamp(abs(offset) / max(span, 1.0e-6), 0.0, 1.0));
    return 0.5 + 0.5 * sign(offset) * t;
}

//沿一段视线距离积分，起点靠近相机、终点更远，步长在靠近最近点的那一端最小
void AccumulateSegment(float h, vec3 up, vec3 ray, float start, float end, int steps, bool denseAtStart,
    float aerosolDensity, vec3 sunRadiance, vec3 sunDirection, int outputKind,
    inout vec3 transmittance, inout vec3 radiance, inout vec3 tau)
{
    if (steps <= 0 || start == end) return;

    float mu = dot(up, ray);
    float muSun = dot(ray, sunDirection);
    vec2 phase = EvaluatePhase(muSun);
    float previous = start;
    for (int index = 1; index <= AtmosphereMaxSteps; ++index)
    {
        if (index > steps) break;

        //二次分布的边界：最近点在起点用平方，最近点在终点用反向平方，两端步长都向最近点收敛
        float ratio = float(index) / float(steps);
        ratio = denseAtStart ? ratio * ratio : 1.0 - (1.0 - ratio) * (1.0 - ratio);
        float boundary = mix(start, end, ratio);
        float ds = abs(previous - boundary);
        float sampleDistance = (previous + boundary) * 0.5;
        previous = boundary;

        vec3 scatteringRayleigh = vec3(0.0);
        vec3 scatteringMie = vec3(0.0);
        vec3 extinction = vec3(0.0);
        EvaluateScattering(ComputeAltitude(h, mu, sampleDistance), aerosolDensity, scatteringRayleigh, scatteringMie, extinction);

        //分段解析积分权重，sigmaT 过小时退化为步长
        vec3 attenuation = exp(-extinction * ds);
        vec3 weight = mix(vec3(ds), (vec3(1.0) - attenuation) / max(extinction, vec3(1.0e-6)), step(vec3(1.0e-6), extinction));

        if (outputKind == 0)
        {
            //查询当前采样点的太阳透光率，局部向上方向由地心指向该点
            vec3 localUp = normalize((AtmosphereGroundRadius + h) * up + sampleDistance * ray);
            vec3 sunTransmittance = SampleSunTransmittance(ComputeAltitude(h, mu, sampleDistance), dot(localUp, sunDirection));
            vec3 inscatter = sunRadiance * sunTransmittance *
                (scatteringRayleigh * phase.x + scatteringMie * phase.y);
            radiance += transmittance * inscatter * weight;
        }

        transmittance *= attenuation;
        tau += extinction * ds;
    }
}

//沿视线积分单次散射，outputKind 为 0 输出散射亮度、为 1 只输出光学厚度
void IntegrateAtmosphere(float h, vec3 up, vec3 ray, float distance, int stepCount, int outputKind,
    float aerosolDensity, vec3 sunRadiance, vec3 sunDirection, out vec3 outRadiance, out vec3 outTau)
{
    outRadiance = vec3(0.0);
    outTau = vec3(0.0);

    float mu = dot(up, ray);
    float start = 0.0;
    float end = 0.0;
    ClipAtmosphereSegment(h, mu, distance, start, end);
    if (end <= start) return;

    //以离地心最近的点把区间分成左右两段，步数平均分配
    float closest = clamp(-(AtmosphereGroundRadius + h) * mu, start, end);
    int leftSteps = 0;
    int rightSteps = 0;
    if (closest <= 0.0) rightSteps = stepCount;
    else if (closest >= end) leftSteps = stepCount;
    else
    {
        leftSteps = max(stepCount / 2, 1);
        rightSteps = stepCount - leftSteps;
    }

    //两段都按相机到远方的顺序推进，透光率才能在最近点处正确续接
    vec3 transmittance = vec3(1.0);
    vec3 radiance = vec3(0.0);
    vec3 tau = vec3(0.0);
    AccumulateSegment(h, up, ray, start, closest, leftSteps, false, aerosolDensity, sunRadiance, sunDirection,
        outputKind, transmittance, radiance, tau);
    AccumulateSegment(h, up, ray, closest, end, rightSteps, true, aerosolDensity, sunRadiance, sunDirection,
        outputKind, transmittance, radiance, tau);

    outRadiance = radiance;
    outTau = min(tau, vec3(20.0));
}
