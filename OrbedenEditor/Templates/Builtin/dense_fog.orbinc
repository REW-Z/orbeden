--------frag
//贴地浓雾：以地心为球心的球壳介质，密度沿高度剖面变化，光学厚度按路径积分。
//与球形薄霾分开配置，近距浓雾不依赖面向远景的稀疏查找表。
//宿主 Shader 需要声明 uniform float u_AtmosphereCameraHeightKm; 与 uniform vec3 u_AtmosphereCameraUp;

uniform int u_AtmosphereDenseFogEnabled;
//满密度区的消光系数，每 km，由 CPU 按 MOR 从能见度换算
uniform float u_AtmosphereDenseFogExtinction;
//散射亮度，取环境光与主光之和
uniform vec4 u_AtmosphereDenseFogScattering;
//(雾顶高度 km, 预留, 预留, 参考球半径 km)
uniform vec4 u_AtmosphereDenseFogProfile;
//雾顶衰减尺度 km，名义顶部保留稀薄尾部
uniform float u_AtmosphereDenseFogTopFade;

//积分步数的编译上限与默认分配
const int FogMaxSteps = 32;
const int FogStepCount = 32;

//按相对高度求射线与球面的两个交点
bool IntersectFogBoundary(float cameraHeight, float mu, float height, float groundRadius, out float entry, out float exit)
{
    entry = 0.0;
    exit = 0.0;

    float b = (groundRadius + cameraHeight) * mu;
    float c = (cameraHeight - height) * (2.0 * groundRadius + cameraHeight + height);
    float discriminant = b * b - c;
    if (discriminant < 0.0) return false;

    float root = -b - (b < 0.0 ? -1.0 : 1.0) * sqrt(max(discriminant, 0.0));
    float first = root != 0.0 ? root : -b;
    float second = root != 0.0 ? c / root : -b;
    entry = min(first, second);
    exit = max(first, second);
    return true;
}

//求射线在本地球壳 [inner, outer] 内的首段区间。
//不累计穿过内球后的背面雾层；inner 取到参考球心时没有内球可挖。边界参数使用相对高度。
int ComputeShellIntervals(float cameraHeight, float mu, float inner, float outer, float groundRadius, float maxDistance,
    out float firstStart, out float firstEnd, out float secondStart, out float secondEnd)
{
    firstStart = 0.0;
    firstEnd = 0.0;
    secondStart = 0.0;
    secondEnd = 0.0;

    float outerEntry = 0.0;
    float outerExit = 0.0;
    if (!IntersectFogBoundary(cameraHeight, mu, outer, groundRadius, outerEntry, outerExit)) return 0;

    //排除底面以下朝向行星背面的射线
    if (cameraHeight < inner && mu < 0.0) return 0;

    float start = max(outerEntry, 0.0);
    float end = min(outerExit, maxDistance);
    if (end <= start) return 0;

    float innerEntry = 0.0;
    float innerExit = 0.0;
    if (inner <= -groundRadius || !IntersectFogBoundary(cameraHeight, mu, inner, groundRadius, innerEntry, innerExit))
    {
        firstStart = start;
        firstEnd = end;
        return 1;
    }

    //挖掉内球区间后剩下的部分
    float cutStart = max(innerEntry, start);
    float cutEnd = min(innerExit, end);
    if (cutEnd <= cutStart)
    {
        firstStart = start;
        firstEnd = end;
        return 1;
    }

    //只保留相机所在一侧的雾层
    if (cutStart > start)
    {
        firstStart = start;
        firstEnd = cutStart;
    }
    else
    {
        firstStart = cutEnd;
        firstEnd = end;
    }
    return firstEnd > firstStart ? 1 : 0;
}

//计算射线在给定距离处的相对高度
float ComputeFogHeight(float cameraHeight, float mu, float distance, float groundRadius)
{
    float q = cameraHeight * (2.0 * groundRadius + cameraHeight)
        + 2.0 * (groundRadius + cameraHeight) * mu * distance + distance * distance;
    return q / (sqrt(max(groundRadius * groundRadius + q, 0.0)) + groundRadius);
}

//高度剖面：雾层没有底面，雾顶以下一直是满密度，只在雾顶平滑降至 5%，再延伸指数尾部。
//尾部为 0.05 * (1 + t) * exp(-t)，与层内渐变在顶部具有相同的一阶导数。
float EvaluateFogProfile(float height, float top, float topFade)
{
    if (height > top + 24.0 * topFade) return 0.0;
    if (topFade <= 0.0 || height <= top - topFade) return 1.0;

    if (height <= top)
    {
        float t = (height - (top - topFade)) / topFade;
        return 1.0 - 0.95 * t * t * (3.0 - 2.0 * t);
    }

    float t = (height - top) / topFade;
    return 0.05 * (1.0 + t) * exp(-t);
}

//沿一段区间积分密度，步长均匀，取每段中点的密度
float IntegrateFogInterval(float cameraHeight, float mu, float start, float end, int steps,
    float top, float topFade, float groundRadius)
{
    if (steps <= 0 || end <= start) return 0.0;

    float ds = (end - start) / float(steps);
    float length = 0.0;
    for (int index = 0; index < FogMaxSteps; ++index)
    {
        if (index >= steps) break;

        float distance = start + (float(index) + 0.5) * ds;
        float height = ComputeFogHeight(cameraHeight, mu, distance, groundRadius);
        length += EvaluateFogProfile(height, top, topFade) * ds;
    }

    return length;
}

//查询浓雾。距离以 km 计，距离之外不计入。
//entryDistanceKm 返回首次进入雾层的距离，相机在层内时为 0，未命中时为负值。
void SampleDenseFog(float cameraHeightKm, vec3 cameraUp, vec3 ray, float distanceKm,
    out vec3 transmittance, out vec3 radiance, out float entryDistanceKm)
{
    transmittance = vec3(1.0);
    radiance = vec3(0.0);
    entryDistanceKm = -1.0;
    if (u_AtmosphereDenseFogEnabled == 0 || u_AtmosphereDenseFogExtinction <= 0.0) return;

    float groundRadius = u_AtmosphereDenseFogProfile.w;
    float mu = dot(cameraUp, ray);

    //读取相对参考球面的高度剖面；雾层没有底面，几何下界取到参考球心
    float topHeight = max(u_AtmosphereDenseFogProfile.x, -groundRadius);
    float topFade = clamp(u_AtmosphereDenseFogTopFade, 0.0, max(topHeight, 0.0));
    float topBoundary = max(topHeight + 24.0 * topFade, -groundRadius);

    float firstStart = 0.0;
    float firstEnd = 0.0;
    float secondStart = 0.0;
    float secondEnd = 0.0;
    int count = ComputeShellIntervals(cameraHeightKm, mu, -groundRadius, topBoundary, groundRadius, distanceKm,
        firstStart, firstEnd, secondStart, secondEnd);
    if (count == 0) return;

    entryDistanceKm = firstStart;

    float pathLength = 0.0;
    if (topFade <= 0.0)
    {
        //均匀层没有可积分的剖面，直接用区间长度，结果与逐步积分一致
        pathLength = (firstEnd - firstStart) + (secondEnd - secondStart);
    }
    else
    {
        float firstLength = firstEnd - firstStart;
        float secondLength = secondEnd - secondStart;
        int firstSteps = FogStepCount;
        int secondSteps = 0;
        if (count == 2)
        {
            float total = firstLength + secondLength;
            firstSteps = max(int(float(FogStepCount) * firstLength / max(total, 1.0e-6)), 1);
            secondSteps = max(FogStepCount - firstSteps, 1);
        }

        pathLength = IntegrateFogInterval(cameraHeightKm, mu, firstStart, firstEnd, firstSteps,
            topHeight, topFade, groundRadius);
        if (count == 2)
        {
            pathLength += IntegrateFogInterval(cameraHeightKm, mu, secondStart, secondEnd, secondSteps,
                topHeight, topFade, groundRadius);
        }
    }

    if (pathLength <= 0.0) return;

    //消光沿路径积分；散射按环境光与主光的照明近似，随消光同步增长
    transmittance = vec3(exp(-u_AtmosphereDenseFogExtinction * pathLength));
    radiance = u_AtmosphereDenseFogScattering.rgb * (vec3(1.0) - transmittance);
}

//浓雾调试视图：0 关闭，1 命中与区间数，2 首次进入距离，3 穿雾总长，
//4 光学厚度（0~5），5 透光率，6 散射贡献。显示范围写在返回色上，不做饱和裁剪以外的处理。
vec3 GetDenseFogDebugColor(float cameraHeightKm, vec3 cameraUp, vec3 ray, float distanceKm, int view)
{
    if (view <= 0) return vec3(0.0);

    float groundRadius = u_AtmosphereDenseFogProfile.w;
    float mu = dot(cameraUp, ray);
    float topHeight = max(u_AtmosphereDenseFogProfile.x, -groundRadius);
    float topFade = clamp(u_AtmosphereDenseFogTopFade, 0.0, max(topHeight, 0.0));
    float topBoundary = max(topHeight + 24.0 * topFade, -groundRadius);

    float firstStart = 0.0;
    float firstEnd = 0.0;
    float secondStart = 0.0;
    float secondEnd = 0.0;
    int count = ComputeShellIntervals(cameraHeightKm, mu, -groundRadius, topBoundary, groundRadius, distanceKm,
        firstStart, firstEnd, secondStart, secondEnd);

    if (view == 1)
    {
        if (count == 0) return vec3(0.0);
        return count == 1 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
    }

    if (count == 0) return vec3(0.0);

    if (view == 2) return vec3(clamp(firstStart / 0.5, 0.0, 1.0));
    if (view == 3) return vec3(clamp(((firstEnd - firstStart) + (secondEnd - secondStart)) / 0.5, 0.0, 1.0));

    float pathLength = 0.0;
    if (topFade <= 0.0)
    {
        pathLength = (firstEnd - firstStart) + (secondEnd - secondStart);
    }
    else
    {
        float firstLength = firstEnd - firstStart;
        float secondLength = secondEnd - secondStart;
        int firstSteps = FogStepCount;
        int secondSteps = 0;
        if (count == 2)
        {
            float total = firstLength + secondLength;
            firstSteps = max(int(float(FogStepCount) * firstLength / max(total, 1.0e-6)), 1);
            secondSteps = max(FogStepCount - firstSteps, 1);
        }

        pathLength = IntegrateFogInterval(cameraHeightKm, mu, firstStart, firstEnd, firstSteps,
            topHeight, topFade, groundRadius);
        if (count == 2)
        {
            pathLength += IntegrateFogInterval(cameraHeightKm, mu, secondStart, secondEnd, secondSteps,
                topHeight, topFade, groundRadius);
        }
    }

    float tau = u_AtmosphereDenseFogExtinction * pathLength;
    if (view == 4) return vec3(clamp(tau / 5.0, 0.0, 1.0));
    if (view == 5) return vec3(exp(-min(tau, 20.0)));
    if (view == 6) return clamp(u_AtmosphereDenseFogScattering.rgb * (1.0 - exp(-min(tau, 20.0))), 0.0, 1.0);
    return vec3(0.0);
}
