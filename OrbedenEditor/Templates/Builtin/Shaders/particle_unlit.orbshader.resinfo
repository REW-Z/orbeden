{"Version":7,"Source":"Builtin/Shaders/particle_unlit.orbshader","Settings":{},"Dependencies":[{"Path":"Builtin/Shaders/particle_unlit.orbshader","Length":2163,"Modified":639270225302116229},{"Path":"Builtin/geometry_input.orbinc","Length":3854,"Modified":639261610040732462},{"Path":"Builtin/atmosphere_sampling.orbinc","Length":5341,"Modified":639270225302935360},{"Path":"Builtin/dense_fog.orbinc","Length":5838,"Modified":639270225302945377}],"Blobs":["particle_unlit.orbshader.b6fd3c6b772d02fd.orbo"],"Data":{"Objects":[{"Key":"Builtin/Shaders/particle_unlit.orbshader","TypeName":"Shader","BlobName":"particle_unlit.orbshader.b6fd3c6b772d02fd.orbo","Fields":[{"Name":"name","TypeName":"std::string","Value":"particle_unlit"},{"Name":"vertexPath","TypeName":"std::string","Value":"Builtin/Shaders/particle_unlit.orbshader"},{"Name":"fragmentPath","TypeName":"std::string","Value":"Builtin/Shaders/particle_unlit.orbshader"},{"Name":"vertexSource","TypeName":"std::string","Value":"#version 430 core\n\nlayout(location = 0) in vec3 a_Position;\nlayout(location = 1) in vec3 a_Normal;\nlayout(location = 2) in vec2 a_TexCoord;\nlayout(location = 3) in vec3 a_Tangent;\n\nuniform mat4 u_ViewProjection;\n//\u51E0\u4F55 ABI \u8F93\u5165\u3002\u9876\u70B9\u7740\u8272\u5668\u5305\u542B\u672C\u6587\u4EF6\u540E\uFF0C\u6309 ORBEDEN_GEOMETRY_MODE \u9009\u62E9\u9876\u70B9\u6570\u636E\u6765\u6E90\u3002\n//0 = Uniform \u5355\u7ED8\u5236\uFF0C1 = \u5B9E\u4F8B\u7ED8\u5236\uFF0C2 = \u5C55\u5F00\u9876\u70B9\uFF0C3 = \u62D6\u5C3E\u5B9E\u4F8B\u3002\n//\u5B8F\u7531\u7740\u8272\u5668\u5BFC\u5165\u5728 #version \u4E4B\u540E\u6CE8\u5165\uFF1B\u5355\u72EC\u7F16\u8BD1\u672C\u6587\u4EF6\u65F6\u6309\u5355\u7ED8\u5236\u5904\u7406\u3002\n#ifndef ORBEDEN_GEOMETRY_MODE\n#define ORBEDEN_GEOMETRY_MODE 0\n#endif\n\n#if ORBEDEN_GEOMETRY_MODE == 0\nuniform mat4 u_Model;\n//\u7BA1\u7EBF\u663E\u5F0F\u7ED1\u5B9A\u7684\u6BCF\u6279 tint \u4E0E\u56FE\u96C6\u53D8\u6362\uFF0C\u4E0D\u4F9D\u8D56 GL \u7684 uniform \u9ED8\u8BA4\u503C\nuniform vec4 u_InstanceTint;\nuniform vec4 u_InstanceUvRect;\n#elif ORBEDEN_GEOMETRY_MODE == 1\nlayout(location = 5) in vec4 a_InstanceModel0;\nlayout(location = 6) in vec4 a_InstanceModel1;\nlayout(location = 7) in vec4 a_InstanceModel2;\nlayout(location = 8) in vec4 a_InstanceModel3;\nlayout(location = 9) in vec4 a_InstanceNormal0;\nlayout(location = 10) in vec4 a_InstanceNormal1;\nlayout(location = 11) in vec4 a_InstanceNormal2;\nlayout(location = 12) in vec4 a_InstanceTint;\nlayout(location = 13) in vec4 a_InstanceUvRect;\n#elif ORBEDEN_GEOMETRY_MODE == 2\nlayout(location = 4) in vec4 a_ExpandedTint;\n#else\nlayout(location = 5) in vec4 a_TrailCorner0;\nlayout(location = 6) in vec4 a_TrailCorner1;\nlayout(location = 7) in vec4 a_TrailCorner2;\nlayout(location = 8) in vec4 a_TrailCorner3;\nlayout(location = 9) in vec4 a_TrailStartColor;\nlayout(location = 10) in vec4 a_TrailEndColor;\nlayout(location = 11) in vec4 a_TrailUvRange;\n#endif\n\n//\u4E16\u754C\u77E9\u9635\u3002\u5C55\u5F00\u9876\u70B9\u5DF2\u662F\u4E16\u754C\u7A7A\u95F4\uFF0C\u62D6\u5C3E\u5B9E\u4F8B\u4E0D\u7528\u6A21\u578B\u77E9\u9635\u3002\nmat4 OrbedenGetModel()\n{\n#if ORBEDEN_GEOMETRY_MODE == 0\n    return u_Model;\n#elif ORBEDEN_GEOMETRY_MODE == 1\n    return mat4(a_InstanceModel0, a_InstanceModel1, a_InstanceModel2, a_InstanceModel3);\n#else\n    return mat4(1.0);\n#endif\n}\n\n//\u6CD5\u7EBF\u77E9\u9635\u3002\u5355\u7ED8\u5236\u7531\u6A21\u578B\u77E9\u9635\u6C42\u9006\u8F6C\u7F6E\uFF0C\u5B9E\u4F8B\u7ED8\u5236\u8BFB CPU \u6C42\u597D\u7684\u4E09\u5217\u3002\nmat3 OrbedenGetNormalMatrix()\n{\n#if ORBEDEN_GEOMETRY_MODE == 0\n    return transpose(inverse(mat3(u_Model)));\n#elif ORBEDEN_GEOMETRY_MODE == 1\n    return mat3(a_InstanceNormal0.xyz, a_InstanceNormal1.xyz, a_InstanceNormal2.xyz);\n#else\n    return mat3(1.0);\n#endif\n}\n\n//\u6BCF\u5B9E\u4F8B\u6216\u6BCF\u7C92\u5B50\u7684 tint\uFF0C\u5DF2\u7ECF\u662F\u7EBF\u6027\u7A7A\u95F4\nvec4 OrbedenGetTint()\n{\n#if ORBEDEN_GEOMETRY_MODE == 0\n    return u_InstanceTint;\n#elif ORBEDEN_GEOMETRY_MODE == 1\n    return a_InstanceTint;\n#elif ORBEDEN_GEOMETRY_MODE == 2\n    return a_ExpandedTint;\n#else\n    return vec4(1.0);\n#endif\n}\n\n//\u56FE\u96C6 UV \u53D8\u6362\u3002\u5C55\u5F00\u9876\u70B9\u5728 CPU \u5DF2\u7ECF\u53D8\u6362\u5B8C\u6210\uFF0C\u8FD9\u91CC\u539F\u6837\u8FD4\u56DE\u3002\nvec2 OrbedenGetUv(vec2 uv)\n{\n#if ORBEDEN_GEOMETRY_MODE == 0\n    return uv * u_InstanceUvRect.zw \u002B u_InstanceUvRect.xy;\n#elif ORBEDEN_GEOMETRY_MODE == 1\n    return uv * a_InstanceUvRect.zw \u002B a_InstanceUvRect.xy;\n#elif ORBEDEN_GEOMETRY_MODE == 3\n    //\u62D6\u5C3E\u5B9E\u4F8B\uFF1A\u6CBF\u957F\u5EA6\u7684 uv \u7531\u5F27\u957F\u533A\u95F4\u7ED9\u51FA\uFF0C\u6A2A\u5411\u4ECD\u662F\u56DB\u8FB9\u5F62\u81EA\u8EAB\u7684 V\u3002\n    //\u7ED3\u679C\u5FC5\u987B\u4E0E\u5C55\u5F00\u8DEF\u5F84\u5199\u5728\u9876\u70B9\u91CC\u7684 (longitudinal, lateral) \u5B8C\u5168\u4E00\u81F4\u3002\n    return vec2(mix(a_TrailUvRange.x, a_TrailUvRange.y, uv.y), uv.x);\n#else\n    return uv;\n#endif\n}\n\n//\u62D6\u5C3E\u89D2\u70B9\u4F4D\u7F6E\u3002\u975E\u62D6\u5C3E\u6A21\u5F0F\u9000\u56DE\u666E\u901A\u9876\u70B9\uFF0C\u4FDD\u8BC1\u6240\u6709\u58F0\u660E\u53D8\u4F53\u90FD\u80FD\u7F16\u8BD1\u3002\nvec3 OrbedenGetTrailPosition(vec2 uv)\n{\n#if ORBEDEN_GEOMETRY_MODE == 3\n    vec4 startCorner = mix(a_TrailCorner0, a_TrailCorner1, uv.x);\n    vec4 endCorner = mix(a_TrailCorner3, a_TrailCorner2, uv.x);\n    return mix(startCorner, endCorner, uv.y).xyz;\n#else\n    return (OrbedenGetModel() * vec4(a_Position, 1.0)).xyz;\n#endif\n}\n\n//\u62D6\u5C3E\u989C\u8272\uFF0C\u6CBF\u957F\u5EA6\u5728\u4E24\u7AEF\u989C\u8272\u4E4B\u95F4\u63D2\u503C\nvec4 OrbedenGetTrailColor(vec2 uv)\n{\n#if ORBEDEN_GEOMETRY_MODE == 3\n    return mix(a_TrailStartColor, a_TrailEndColor, uv.y);\n#elif ORBEDEN_GEOMETRY_MODE == 2\n    return a_ExpandedTint;\n#else\n    return OrbedenGetTint();\n#endif\n}\n\nout vec2 v_TexCoord;\nout vec4 v_Tint;\nout vec3 v_WorldPosition;\n\nvoid main()\n{\n    //\u5C55\u5F00\u9876\u70B9\u5DF2\u7ECF\u662F\u4E16\u754C\u7A7A\u95F4\uFF0C\u56FE\u96C6\u53D8\u6362\u4E5F\u5DF2\uFFFD\n... (truncated)"},{"Name":"fragmentSource","TypeName":"std::string","Value":"#version 430 core\n\nin vec2 v_TexCoord;\nin vec4 v_Tint;\nin vec3 v_WorldPosition;\n\nuniform vec3 u_CameraPosition;\nuniform bool u_HasDiffuseTexture;\nuniform sampler2D u_DiffuseTexture;\nuniform vec4 u_DiffuseColor;\nuniform float u_Intensity;\nuniform bool u_AtmosphereAdditive;\n//\u8868\u9762\u7247\u5143\u7684\u7A7A\u6C14\u900F\u89C6\u4E0E\u6D53\u96FE\u5408\u6210\u3002\u4E24\u8005\u662F\u5404\u81EA\u72EC\u7ACB\u7684\u529F\u80FD\uFF0C\u5404\u770B\u5404\u7684\u5F00\u5173\uFF1A\n//\u7A7A\u6C14\u900F\u89C6\u67E5\u9762\u5411\u8FDC\u666F\u7684 L/Tau \u56FE\u96C6\uFF0C\u6D53\u96FE\u6309\u9AD8\u5EA6\u5256\u9762\u89E3\u6790\u79EF\u5206\uFF0C\u4E92\u4E0D\u5F15\u7528\u5BF9\u65B9\u7684 uniform\u3002\n//\u5BBF\u4E3B Shader \u9700\u8981\u58F0\u660E uniform vec3 u_CameraPosition; \u672C\u6587\u4EF6\u4E0E shadow_common \u4F9D\u8D56 u_LightDirection \u540C\u7406\u3002\n\nuniform sampler2D u_AtmosphereRadianceTexture;\nuniform sampler2D u_AtmosphereOpticalDepthTexture;\nuniform int u_AtmosphereFogEnabled;\nuniform float u_AtmosphereMaxDistanceKm;\nuniform float u_AtmosphereMetersPerWorldUnit;\nuniform vec4 u_AtmosphereViewport;\n//(\u8282\u70B9\u5BBD, \u8282\u70B9\u9AD8, \u8DDD\u79BB\u5C42\u6570, \u56FE\u96C6\u5217\u6570)\nuniform vec4 u_AtmosphereAtlas;\nuniform float u_AtmosphereCameraHeightKm;\nuniform vec3 u_AtmosphereCameraUp;\n\n//\u6D53\u96FE\u51FD\u6570\u5F15\u7528\u4E0A\u9762\u4E24\u4E2A\u76F8\u673A uniform\uFF0C\u5FC5\u987B\u58F0\u660E\u4E4B\u540E\u624D\u80FD\u5C55\u5F00\n//\u8D34\u5730\u6D53\u96FE\uFF1A\u5BC6\u5EA6\u6CBF\u9AD8\u5EA6\u5256\u9762\u53D8\u5316\uFF0C\u5149\u5B66\u539A\u5EA6\u6309\u8DEF\u5F84\u89E3\u6790\u79EF\u5206\u3002\n//\u4E0E\u7403\u5F62\u8584\u973E\u5206\u5F00\u914D\u7F6E\uFF0C\u8FD1\u8DDD\u6D53\u96FE\u4E0D\u4F9D\u8D56\u9762\u5411\u8FDC\u666F\u7684\u7A00\u758F\u67E5\u627E\u8868\u3002\n//\u5BBF\u4E3B Shader \u9700\u8981\u58F0\u660E uniform float u_AtmosphereCameraHeightKm; \u4E0E uniform vec3 u_AtmosphereCameraUp;\n//\n//\u9AD8\u5EA6\u6309\u5E73\u5730\u8FD1\u4F3C\u6CBF\u5C04\u7EBF\u7EBF\u6027\u53D8\u5316\uFF1Ah(s) = \u76F8\u673A\u9AD8\u5EA6 \u002B mu * s\u3002\u4ECB\u8D28\u7684\u5C3A\u5EA6\uFF08\u80FD\u89C1\u5EA6\u51E0\u5341\u7C73\u5230\u51E0\u516C\u91CC\u3001\n//\u96FE\u9876\u51E0\u5341\u7C73\u5230\u51E0\u516C\u91CC\uFF09\u8FDC\u5C0F\u4E8E\u5730\u7403\u534A\u5F84 6371 km\uFF0C\u4E24\u8005\u7684\u5DEE\u522B\u53EA\u5728\u0022\u76F8\u673A\u9AD8\u4E8E\u96FE\u9876\u5E76\u4FEF\u89C6\u8FDC\u5904\u0022\u65F6\u624D\u53EF\u89C1\uFF0C\n//\u5C42\u5185\u89C6\u7EBF\u5728 200 km \u4EE5\u5185\u4E0D\u53EF\u5206\u8FA8\u3002\u6362\u6765\u7684\u662F\u6574\u4E2A\u5256\u9762\u90FD\u6709\u521D\u7B49\u539F\u51FD\u6570\uFF1A\u9010\u50CF\u7D20\u53EA\u5269\u4E00\u6B21\u51FD\u6570\u6C42\u503C\uFF0C\n//\u6CA1\u6709\u6C42\u79EF\u3001\u6CA1\u6709\u8FB9\u754C\u6C42\u4EA4\uFF0C\u4EE3\u7801\u91CF\u964D\u5230\u539F\u6765\u7684\u767E\u5206\u4E4B\u51E0\u2014\u2014\u8FD9\u4E00\u6761\u662F\u6027\u80FD\u8981\u6C42\uFF0C\u4E0D\u662F\u7CBE\u5EA6\u53D6\u820D\u3002\n\nuniform int u_AtmosphereDenseFogEnabled;\n//\u6EE1\u5BC6\u5EA6\u533A\u7684\u6D88\u5149\u7CFB\u6570\uFF0C\u6BCF km\uFF0C\u7531 CPU \u6309 MOR \u4ECE\u80FD\u89C1\u5EA6\u6362\u7B97\nuniform float u_AtmosphereDenseFogExtinction;\n//\u6563\u5C04\u4EAE\u5EA6\uFF0C\u53D6\u73AF\u5883\u5149\u4E0E\u4E3B\u5149\u4E4B\u548C\nuniform vec4 u_AtmosphereDenseFogScattering;\n//(\u96FE\u9876\u9AD8\u5EA6 km, \u9884\u7559, \u9884\u7559, \u53C2\u8003\u7403\u534A\u5F84 km)\nuniform vec4 u_AtmosphereDenseFogProfile;\n//\u96FE\u9876\u8870\u51CF\u5C3A\u5EA6 km\uFF0C\u540D\u4E49\u9876\u90E8\u4FDD\u7559\u7A00\u8584\u5C3E\u90E8\nuniform float u_AtmosphereDenseFogTopFade;\n//\u5BC6\u5EA6\u6A21\u578B\uFF1A0 \u9AD8\u5EA6\u96FE\uFF08\u8BFB\u96FE\u9876\u4E0E\u8870\u51CF\u5C3A\u5EA6\uFF09\uFF0C1 \u8DDD\u79BB\u96FE\uFF08\u53EA\u7528\u8DDD\u79BB\uFF0C\u4E0A\u9762\u7684\u5256\u9762\u53C2\u6570\u4E0D\u53C2\u4E0E\uFF09\nuniform int u_AtmosphereDenseFogMode;\n\n//\u9AD8\u5EA6\u5256\u9762\uFF1A\u96FE\u5C42\u6CA1\u6709\u5E95\u9762\uFF0C\u96FE\u9876\u4EE5\u4E0B\u4E00\u76F4\u662F\u6EE1\u5BC6\u5EA6\uFF0C\u53EA\u5728\u96FE\u9876\u5E73\u6ED1\u964D\u81F3 5%\uFF0C\u518D\u5EF6\u4F38\u6307\u6570\u5C3E\u90E8\u3002\n//\u5C3E\u90E8\u4E3A 0.05 * (1 \u002B t) * exp(-t)\uFF0C\u4E0E\u5C42\u5185\u6E10\u53D8\u5728\u9876\u90E8\u5177\u6709\u76F8\u540C\u7684\u4E00\u9636\u5BFC\u6570\u3002\nfloat EvaluateFogProfile(float height, float top, float topFade)\n{\n    if (height \u003E top \u002B 24.0 * topFade) return 0.0;\n    if (topFade \u003C= 0.0 || height \u003C= top - topFade) return 1.0;\n\n    if (height \u003C= top)\n    {\n        float t = (height - (top - topFade)) / topFade;\n        return 1.0 - 0.95 * t * t * (3.0 - 2.0 * t);\n    }\n\n    float t = (height - top) / topFade;\n    return 0.05 * (1.0 \u002B t) * exp(-t);\n}\n\n//\u5256\u9762\u7684\u5168\u5C40\u539F\u51FD\u6570\uFF1A\u4ECE\u8D1F\u65E0\u7A77\u9AD8\u5EA6\u79EF\u5230 height \u7684\u5BC6\u5EA6\u7D2F\u8BA1\u91CF\u3002\n//\u5206\u6BB5\u79EF\u5206\u53D6\u8FDE\u7EED\u5E38\u6570\uFF0C\u5728 h = top-fade\u3001top\u3001top\u002B24*topFade \u4E09\u5904\u90FD\u4E0E\u4E0A\u4E00\u6BB5\u7B49\u503C\uFF0C\u51FD\u6570\u5168\u57DF\u8FDE\u7EED\uFF1A\n//   \u6052\u4E3A 1      \u222Bdh = h\n//   smoothstep  \u222B(1 - 0.95*t^2*(3 - 2t))dh = h - 0.95*fade*(t^3 - 0.5*t^4)\n//   \u6307\u6570\u5C3E\u90E8    \u222B0.05*(1 \u002B u)*exp(-u)dh = -0.05*fade*((u \u002B 2)*exp(-u))\nfloat EvaluateFogProfileIntegral(float height, float top, float topFade)\n{\n    //\u8870\u51CF\u5C3A\u5EA6\u4E3A\u96F6\u662F\u786C\u9876\uFF1A\u6EE1\u5BC6\u5EA6\u4E00\u76F4\u4FDD\u6301\u5230\u96FE\u9876\uFF0C\u539F\u51FD\u6570\u662F\u6298\u7EBF\n    if (topFade \u003C= 0.0) return min(height, top);\n\n    float base = top - topFade;\n    if (height \u003C= base) return height;\n\n    if (height \u003C= top)\n    {\n        float t = (height - base) / topFade;\n        return base \u002B topFade * (t - 0.95 * t * t * t \u002B 0.475 * t * t * t * t);\n    }\n\n    //\u96FE\u9876\u5904\u7684\u503C\uFF1Abase \u002B topFade * (1 - 0.95 \u002B 0.475) = top - 0.475 * topFade\n    flo\n... (truncated)"},{"Name":"passes","TypeName":"List\u003CShaderPass\u003E","Value":"1 elements\nDefault"},{"Name":"textureSlots","TypeName":"List\u003CShaderTextureSlot\u003E","Value":"1 elements"},{"Name":"colorSlots","TypeName":"List\u003CShaderColorSlot\u003E","Value":"1 elements"},{"Name":"floatSlots","TypeName":"List\u003CShaderFloatSlot\u003E","Value":"1 elements"}]}],"Messages":[],"IsStale":false,"IsLoading":false},"Runtime":null}