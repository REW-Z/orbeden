--------queue Opaque

--------vert
#version 430 core
layout(location = 0) in vec3 a_Position;
layout(location = 1) in vec3 a_Normal;
layout(location = 2) in vec2 a_TexCoord;
uniform mat4 u_Model;
uniform mat4 u_ViewProjection;
out vec2 v_TexCoord;
out vec3 v_WorldPosition;
out vec3 v_Normal;
out vec4 v_ClipPosition;
void main()
{
    v_TexCoord = a_TexCoord;
    v_WorldPosition = (u_Model * vec4(a_Position, 1.0)).xyz;
    v_Normal = transpose(inverse(mat3(u_Model))) * a_Normal;
    v_ClipPosition = u_ViewProjection * vec4(v_WorldPosition, 1.0);
    gl_Position = v_ClipPosition;
}

--------frag
#version 430 core
in vec2 v_TexCoord;
in vec3 v_WorldPosition;
in vec3 v_Normal;
in vec4 v_ClipPosition;
uniform vec3 u_CameraPosition;
uniform vec3 u_LightDirection;
uniform vec4 u_LightColor;
uniform float u_LightIntensity;
uniform vec4 u_AmbientColor;
uniform vec4 u_DiffuseColor;
uniform vec4 u_EmissionColor;
uniform float u_Metallic;
uniform float u_Roughness;
uniform float u_Occlusion;
uniform bool u_HasDiffuseTexture;
uniform sampler2D u_DiffuseTexture;
#include "Builtin/shadow_common.orbinc"
out vec4 FragColor;

void main()
{
    const float Pi = 3.14159265359;
    vec3 albedo = max(u_DiffuseColor.rgb, vec3(0.0));
    if (u_HasDiffuseTexture) albedo *= texture(u_DiffuseTexture, v_TexCoord).rgb;
    float metallic = clamp(u_Metallic, 0.0, 1.0);
    float roughness = clamp(u_Roughness, 0.045, 1.0);
    vec3 normal = normalize(v_Normal);
    vec3 viewDir = normalize(u_CameraPosition - v_WorldPosition);
    vec3 lightDir = normalize(-u_LightDirection);
    vec3 halfVector = viewDir + lightDir;
    vec3 halfDir = halfVector / max(length(halfVector), 0.0001);
    float nDotV = max(dot(normal, viewDir), 0.0001);
    float nDotL = max(dot(normal, lightDir), 0.0);
    float nDotH = max(dot(normal, halfDir), 0.0);
    float vDotH = max(dot(viewDir, halfDir), 0.0);

    //计算 GGX 分布、Smith 遮蔽和 Schlick 菲涅耳
    float alpha = roughness * roughness;
    float alphaSquared = alpha * alpha;
    float denominator = nDotH * nDotH * (alphaSquared - 1.0) + 1.0;
    float distribution = alphaSquared / max(Pi * denominator * denominator, 0.000001);
    float geometryV = 2.0 * nDotV / max(nDotV + sqrt(alphaSquared + (1.0 - alphaSquared) * nDotV * nDotV), 0.0001);
    float geometryL = 2.0 * nDotL / max(nDotL + sqrt(alphaSquared + (1.0 - alphaSquared) * nDotL * nDotL), 0.0001);
    vec3 f0 = mix(vec3(0.04), albedo, metallic);
    vec3 fresnel = f0 + (1.0 - f0) * pow(1.0 - vDotH, 5.0);
    vec3 specular = distribution * geometryV * geometryL * fresnel / max(4.0 * nDotV * nDotL, 0.0001);
    vec3 diffuse = (1.0 - fresnel) * (1.0 - metallic) * albedo / Pi;

    //合成主光、级联阴影和近似环境漫反射
    float shadow = SampleShadow(v_WorldPosition, normal);
    vec3 direct = (diffuse + specular) * nDotL * u_LightColor.rgb * max(u_LightIntensity, 0.0) * (1.0 - shadow);
    vec3 ambient = u_AmbientColor.rgb * albedo * (1.0 - metallic) * clamp(u_Occlusion, 0.0, 1.0);
    vec3 result = direct + ambient + max(u_EmissionColor.rgb, vec3(0.0));
    //输出线性值。曝光、色调映射与 sRGB 编码统一由管线末端的输出 Pass 完成，
    //本 Shader 不做任何颜色空间转换。
    FragColor = vec4(GetShadowDebugColor(v_WorldPosition, result), 1.0);
}
