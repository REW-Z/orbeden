--------queue Opaque

--------geometry Standard
--------expandedGeometry off

--------vert
#version 430 core

layout(location = 0) in vec3 a_Position;

out vec2 v_Uv;

void main()
{
    v_Uv = a_Position.xy * 0.5 + 0.5;
    gl_Position = vec4(a_Position.xy, 0.0, 1.0);
}

--------frag
#version 430 core

in vec2 v_Uv;

uniform float u_AtmosphereAerosolDensity;
#include "Builtin/atmosphere_common.orbinc"

out vec4 FragColor;

void main()
{
    //像素换算到网格节点，节点高度与视线余弦都取平方分布
    vec2 node = v_Uv * u_AtmosphereTransSize.xy - 0.5;
    float v = clamp(node.y / max(u_AtmosphereTransSize.y - 1.0, 1.0), 0.0, 1.0);
    float u = clamp(node.x / max(u_AtmosphereTransSize.x - 1.0, 1.0), 0.0, 1.0);
    float h = AtmosphereTopHeight * v * v;
    float muHorizon = -sqrt(max(h * (2.0 * AtmosphereGroundRadius + h), 0.0)) / (AtmosphereGroundRadius + h);
    float mu = muHorizon + (1.0 - muHorizon) * u * u;

    //沿节点方向积到大气顶，只累积光学厚度
    vec3 up = vec3(0.0, 1.0, 0.0);
    vec3 ray = vec3(sqrt(max(1.0 - mu * mu, 0.0)), mu, 0.0);
    vec3 radiance = vec3(0.0);
    vec3 tau = vec3(0.0);
    IntegrateAtmosphere(h, up, ray, 1000000.0, 64, 1, u_AtmosphereAerosolDensity, vec3(0.0), ray, radiance, tau);

    //存光学厚度本身，由采样端取 exp(-tau)：tau 是 O(1)~20 的量，半精度足够；
    //存 exp(-tau) 会在掠射时把蓝通道下溢成 0，做比值/相减的用法会拿到错值
    FragColor = vec4(tau, 1.0);
}
