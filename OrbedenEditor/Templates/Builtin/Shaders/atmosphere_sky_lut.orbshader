--------queue Opaque

--------geometry Standard
--------expandedGeometry off

--------vert
#version 430 core

layout(location = 0) in vec3 a_Position;

out vec2 v_Uv;

void main()
{
    v_Uv = a_Position.xy * 0.5 + 0.5;
    gl_Position = vec4(a_Position.xy, 0.0, 1.0);
}

--------frag
#version 430 core

in vec2 v_Uv;

uniform mat4 u_AtmosphereInverseProjection;
uniform mat4 u_AtmosphereCameraWorldRotation;
uniform float u_AtmosphereCameraHeightKm;
uniform vec3 u_AtmosphereCameraUp;
uniform vec3 u_AtmosphereSunDirection;
uniform vec4 u_AtmosphereSunRadiance;
uniform vec4 u_AtmosphereGroundBackground;
uniform float u_AtmosphereAerosolDensity;
uniform vec4 u_AtmosphereSkySize;
uniform int u_AtmosphereStepCount;
#include "Builtin/atmosphere_common.orbinc"

out vec4 FragColor;

void main()
{
    //节点还原成视线方向，与图集使用同一套屏幕方向映射
    vec2 node = v_Uv * u_AtmosphereSkySize.xy - 0.5;
    vec2 uv = clamp(node / max(u_AtmosphereSkySize.xy - 1.0, vec2(1.0)), 0.0, 1.0);
    vec4 viewPosition = u_AtmosphereInverseProjection * vec4(uv * 2.0 - 1.0, 1.0, 1.0);
    vec3 viewRay = normalize((u_AtmosphereCameraWorldRotation * viewPosition).xyz);

    //天空没有远裁剪限制，交给裁剪求交决定积分终点
    vec3 radiance = vec3(0.0);
    vec3 tau = vec3(0.0);
    IntegrateAtmosphere(u_AtmosphereCameraHeightKm, u_AtmosphereCameraUp, viewRay, 1000000.0,
        u_AtmosphereStepCount, 0, u_AtmosphereAerosolDensity,
        u_AtmosphereSunRadiance.rgb, u_AtmosphereSunDirection, radiance, tau);

    //命中地球的射线补上未加载远地形的颜色底板，外空间背景保持为零
    vec3 ground = vec3(0.0);
    if (IntersectGroundDistance(u_AtmosphereCameraHeightKm, dot(u_AtmosphereCameraUp, viewRay)) >= 0.0)
    {
        ground = exp(-tau) * u_AtmosphereGroundBackground.rgb;
    }

    FragColor = vec4(radiance + ground, 1.0);
}
