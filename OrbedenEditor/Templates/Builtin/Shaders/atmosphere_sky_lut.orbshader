--------queue Opaque

--------geometry Standard
--------expandedGeometry off

--------vert
#version 430 core

layout(location = 0) in vec3 a_Position;

out vec2 v_Uv;

void main()
{
    v_Uv = a_Position.xy * 0.5 + 0.5;
    gl_Position = vec4(a_Position.xy, 0.0, 1.0);
}

--------frag
#version 430 core

in vec2 v_Uv;

uniform float u_AtmosphereCameraHeightKm;
uniform vec3 u_AtmosphereCameraUp;
uniform vec3 u_AtmosphereSunDirection;
uniform vec4 u_AtmosphereSunRadiance;
uniform float u_AtmosphereAerosolDensity;
uniform vec4 u_AtmosphereSkySize;
uniform int u_AtmosphereStepCount;
#include "Builtin/atmosphere_common.orbinc"

out vec4 FragColor;

void main()
{
    //节点坐标还原成视线方向。表按方向空间存放而不是屏幕空间：
    //行在地平线处加密、地平线落在节点行边界上，掠过地平线的陡变才不会被双线性
    //抹成一段跨越整行的斜坡（那在屏幕上就是轴对齐的台阶）；表也因此与相机朝向无关
    vec2 node = v_Uv * u_AtmosphereSkySize.xy - 0.5;
    vec2 uv = clamp(node / max(u_AtmosphereSkySize.xy - 1.0, vec2(1.0)), 0.0, 1.0);
    float mu = AtmosphereSkyZenithCosFromUv(uv.y, u_AtmosphereCameraHeightKm);
    float lightViewCosAngle = uv.x * 2.0 - 1.0;

    //在 (本地 up, 太阳切向) 平面内重建视线：方位角的正负不影响积分结果
    vec3 up = u_AtmosphereCameraUp;
    float muSun = dot(up, u_AtmosphereSunDirection);
    vec3 sunTangent = u_AtmosphereSunDirection - muSun * up;
    float sunTangentLength = length(sunTangent);
    vec3 fallback = abs(up.x) < 0.9 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 0.0, 1.0);
    vec3 basis = sunTangentLength > 1.0e-5 ? sunTangent / sunTangentLength : normalize(cross(up, fallback));
    float sinMu = sqrt(max(1.0 - mu * mu, 0.0));
    float sinSun = sqrt(max(1.0 - muSun * muSun, 0.0));
    float cosPhi = (sinMu > 1.0e-5 && sinSun > 1.0e-5)
        ? clamp((lightViewCosAngle - mu * muSun) / (sinMu * sinSun), -1.0, 1.0) : 1.0;
    float sinPhi = sqrt(max(1.0 - cosPhi * cosPhi, 0.0));
    vec3 viewRay = normalize(mu * up + sinMu * (cosPhi * basis + sinPhi * cross(up, basis)));

    //天空没有远裁剪限制，交给裁剪求交决定积分终点
    vec3 radiance = vec3(0.0);
    vec3 tau = vec3(0.0);
    IntegrateAtmosphere(u_AtmosphereCameraHeightKm, u_AtmosphereCameraUp, viewRay, 1000000.0,
        u_AtmosphereStepCount, 0, u_AtmosphereAerosolDensity,
        u_AtmosphereSunRadiance.rgb, u_AtmosphereSunDirection, radiance, tau);

    //节点只存沿射线的大气散射，不烘焙地球遮挡与地面底板：底板颜色取决于相机，
    //遮挡又是逐像素量，两者都由天空着色器解析合成
    FragColor = vec4(radiance, 1.0);
}
