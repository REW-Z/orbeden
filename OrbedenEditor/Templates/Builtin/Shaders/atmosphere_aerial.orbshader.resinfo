{"Version":7,"Source":"Builtin/Shaders/atmosphere_aerial.orbshader","Settings":{},"Dependencies":[{"Path":"Builtin/Shaders/atmosphere_aerial.orbshader","Length":2378,"Modified":639262666887031996},{"Path":"Builtin/atmosphere_common.orbinc","Length":11431,"Modified":639270225302935360}],"Blobs":["atmosphere_aerial.orbshader.b4e22be43f96a907.orbo"],"Data":{"Objects":[{"Key":"Builtin/Shaders/atmosphere_aerial.orbshader","TypeName":"Shader","BlobName":"atmosphere_aerial.orbshader.b4e22be43f96a907.orbo","Fields":[{"Name":"name","TypeName":"std::string","Value":"atmosphere_aerial"},{"Name":"vertexPath","TypeName":"std::string","Value":"Builtin/Shaders/atmosphere_aerial.orbshader"},{"Name":"fragmentPath","TypeName":"std::string","Value":"Builtin/Shaders/atmosphere_aerial.orbshader"},{"Name":"vertexSource","TypeName":"std::string","Value":"#version 430 core\n\nlayout(location = 0) in vec3 a_Position;\n\nout vec2 v_Uv;\n\nvoid main()\n{\n    v_Uv = a_Position.xy * 0.5 \u002B 0.5;\n    gl_Position = vec4(a_Position.xy, 0.0, 1.0);\n}\n\n"},{"Name":"fragmentSource","TypeName":"std::string","Value":"#version 430 core\n\nin vec2 v_Uv;\n\nuniform mat4 u_AtmosphereInverseProjection;\nuniform mat4 u_AtmosphereCameraWorldRotation;\nuniform float u_AtmosphereCameraHeightKm;\nuniform vec3 u_AtmosphereCameraUp;\nuniform vec3 u_AtmosphereSunDirection;\nuniform vec4 u_AtmosphereSunRadiance;\nuniform float u_AtmosphereAerosolDensity;\nuniform float u_AtmosphereMaxDistanceKm;\nuniform vec4 u_AtmosphereAtlas;\nuniform int u_AtmosphereOutputKind;\nuniform int u_AtmosphereStepCount;\n//\u7403\u5F62\u5927\u6C14\u7684\u7403\u9762\u6570\u5B66\u3001\u5BC6\u5EA6\u4E0E\u5355\u6B21\u6563\u5C04\u79EF\u5206\u3002\u957F\u5EA6\u5355\u4F4D\u7EDF\u4E00\u4E3A km\uFF0C\u65B9\u5411\u5411\u91CF\u5FC5\u987B\u5DF2\u5F52\u4E00\u5316\u3002\n//\u5BC6\u5EA6\u53EA\u968F\u8DDD\u5730\u5FC3\u7684\u9AD8\u5EA6\u53D8\u5316\uFF0C\u5730\u5F62\u8D77\u4F0F\u4E0D\u53C2\u4E0E\uFF0C\u56E0\u6B64\u6240\u6709\u51FD\u6570\u90FD\u662F\u5F84\u5411\u5BF9\u79F0\u7684\u3002\n\nconst float AtmospherePi = 3.141592653589793;\nconst float AtmosphereGroundRadius = 6371.0;\nconst float AtmosphereTopHeight = 100.0;\nconst float AtmosphereRayleighHeight = 8.0;\nconst float AtmosphereMieHeight = 1.2;\nconst vec3 AtmosphereRayleighScattering = vec3(0.005802, 0.013558, 0.033100);\nconst float AtmosphereMieScattering = 0.003996;\nconst float AtmosphereMieExtinction = 0.004440;\nconst float AtmosphereMieAnisotropy = 0.8;\n//\u592A\u9633\u76D8\u7684\u89D2\u534A\u5F84\uFF0C\u4EE5\u5F27\u5EA6\u8BA1\nconst float AtmosphereSunAngularRadius = 0.00465;\n//\u79EF\u5206\u5FAA\u73AF\u7684\u7F16\u8BD1\u4E0A\u9650\uFF0C\u8D85\u8FC7 StepCount \u7684\u8FED\u4EE3\u5728\u8FD9\u91CC\u9000\u51FA\nconst int AtmosphereMaxSteps = 64;\n\nuniform sampler2D u_AtmosphereTransmittanceTexture;\nuniform vec4 u_AtmosphereTransSize;\n\n//\u53D6\u975E\u96F6\u7B26\u53F7\uFF0C\u907F\u514D\u6C42\u6839\u65F6\u51FA\u73B0\u9664\u4EE5\u96F6\nfloat AtmosphereSignNonzero(float value)\n{\n    return value \u003C 0.0 ? -1.0 : 1.0;\n}\n\n//\u7531\u8D77\u59CB\u9AD8\u5EA6\u4E0E\u89C6\u7EBF\u4F59\u5F26\u6C42\u5C04\u7EBF\u4E0A\u7684\u5C40\u90E8\u9AD8\u5EA6\uFF0C\u8FD1\u5730\u65F6\u7528\u8BE5\u5F0F\u907F\u514D\u76F4\u63A5\u76F8\u51CF\u4E22\u7CBE\u5EA6\nfloat ComputeAltitude(float h, float mu, float s)\n{\n    float q = h * (2.0 * AtmosphereGroundRadius \u002B h) \u002B 2.0 * s * (AtmosphereGroundRadius \u002B h) * mu \u002B s * s;\n    return q / (sqrt(max(AtmosphereGroundRadius * AtmosphereGroundRadius \u002B q, 0.0)) \u002B AtmosphereGroundRadius);\n}\n\n//\u6C42\u5C04\u7EBF\u4E0E\u6307\u5B9A\u9AD8\u5EA6\u7403\u9762\u7684\u4E24\u4E2A\u4EA4\u70B9\uFF0C\u6309 t0\u003C=t1 \u8FD4\u56DE\nbool IntersectAtmosphereBoundary(float h, float mu, float hb, out float t0, out float t1)\n{\n    t0 = 0.0;\n    t1 = 0.0;\n\n    float b = (AtmosphereGroundRadius \u002B h) * mu;\n    float c = (h - hb) * (2.0 * AtmosphereGroundRadius \u002B h \u002B hb);\n    float discriminant = b * b - c;\n    if (discriminant \u003C 0.0) return false;\n\n    float root = -b - AtmosphereSignNonzero(b) * sqrt(max(discriminant, 0.0));\n    float first = root != 0.0 ? root : -b;\n    float second = root != 0.0 ? c / root : -b;\n    t0 = min(first, second);\n    t1 = max(first, second);\n    return true;\n}\n\n//\u6C42\u5C04\u7EBF\u4E0E\u5730\u7403\u8868\u9762\u7684\u9996\u6B21\u4EA4\u70B9\u8DDD\u79BB\uFF0C\u672A\u547D\u4E2D\u65F6\u8FD4\u56DE\u8D1F\u503C\u3002\n//\u76F8\u673A\u4F4E\u4E8E\u53C2\u8003\u7403\u9762\u65F6\u6309\u6D77\u5E73\u9762\u5904\u7406\uFF1A\u6A21\u578B\u7684\u5730\u9762\u5C31\u662F\u53C2\u8003\u7403\u9762\uFF0C\u7403\u9762\u4EE5\u4E0B\u4E0D\u5C5E\u4E8E\u5927\u6C14\uFF0C\n//\u5411\u4E0B\u770B\u7B49\u4E8E\u7AD9\u5728\u5730\u9762\u4E0A\u770B\u811A\u4E0B\uFF0C\u8DDD\u79BB\u4E3A\u96F6\u3002\u8FD9\u6837\u8DE8\u8FC7\u6D77\u5E73\u9762\u65F6\u4E0D\u4F1A\u7A81\u7136\u5207\u6362\u884C\u4E3A\u3002\nfloat IntersectGroundDistance(float h, float mu)\n{\n    float groundHeight = max(h, 0.0);\n\n    //\u5148\u7528\u5730\u5E73\u7EBF\u4F59\u5F26\u5224\u65AD\uFF1A\u8FD1\u5207\u7EBF\u65F6\u5224\u522B\u5F0F\u662F\u76F8\u8FD1\u91CF\u76F8\u51CF\uFF0C\u76F4\u63A5\u6BD4\u8F83\u4F59\u5F26\u66F4\u7A33\n    float muHorizon = -sqrt(max(groundHeight * (2.0 * AtmosphereGroundRadius \u002B groundHeight), 0.0)) /\n        (AtmosphereGroundRadius \u002B groundHeight);\n    if (mu \u003E= muHorizon) return -1.0;\n\n    //\u5730\u9762\u5C31\u5728\u8D77\u70B9\uFF1A\u5411\u4E0B\u7684\u5C04\u7EBF\u4ECE\u53C2\u8003\u7403\u9762\u51FA\u53D1\uFF0C\u6CA1\u6709\u524D\u65B9\u4EA4\u70B9\n    if (groundHeight \u003C= 0.0) return 0.0;\n\n    float t0 = 0.0;\n    float t1 = 0.0;\n    if (!IntersectAtmosphereBoundary(groundHeight, mu, 0.0, t0, t1)) return 0.0;\n\n    float ground = t0 \u003E= 0.0 ? t0 : t1;\n    return max(ground, 0.0);\n}\n\n//\u628A\u89C6\u7EBF\u88C1\u526A\u5230\u5927\u6C14\u5185\u3002\u76F8\u673A\u5728\u5927\u6C14\u5916\u65F6\u8D77\u70B9\u662F\u5165\u5C04\u70B9\uFF0C\u4E0D\u7ECF\u8FC7\u5927\u6C14\u65F6\u533A\u95F4\u4E3A\u7A7A\nvoid ClipAtmosphereSegment(float h, float mu, float distance, out float start, out float end)\n{\n    start = 0.0;\n    end = max(distance, 0.0);\n\n    float t0 = 0.0;\n    float t1 = 0.0;\n    if (!IntersectAtmosphereBoundary(h, mu, AtmosphereTopHeight, t0, t1) || t1 \u003C= 0.0)\n    {\n        end = 0.0;\n        return;\n    }\n\n    start = max(t0, 0.0);\n    end = min(end, t1);\n\n    //\u5730\u7403\u9996\u6B21\u5165\u53E3\u540C\u6837\u53C2\u4E0E\u622A\u65AD\n    f\n... (truncated)"},{"Name":"passes","TypeName":"List\u003CShaderPass\u003E","Value":"1 elements\nDefault"},{"Name":"textureSlots","TypeName":"List\u003CShaderTextureSlot\u003E","Value":"0 elements"},{"Name":"colorSlots","TypeName":"List\u003CShaderColorSlot\u003E","Value":"0 elements"},{"Name":"floatSlots","TypeName":"List\u003CShaderFloatSlot\u003E","Value":"0 elements"}]}],"Messages":[],"IsStale":false,"IsLoading":false},"Runtime":null}