{"Version":7,"Source":"Builtin/Shaders/rain_glass.orbshader","Settings":{},"Dependencies":[{"Path":"Builtin/Shaders/rain_glass.orbshader","Length":5691,"Modified":639270225302255720},{"Path":"Builtin/geometry_input.orbinc","Length":3854,"Modified":639261610040732462},{"Path":"Builtin/surface_refraction.orbinc","Length":597,"Modified":639258331368866360},{"Path":"Builtin/camera_texture_common.orbinc","Length":1075,"Modified":639246226177031012},{"Path":"Builtin/procedural_noise.orbinc","Length":969,"Modified":639258331368866360},{"Path":"Builtin/atmosphere_sampling.orbinc","Length":5341,"Modified":639270225302935360},{"Path":"Builtin/dense_fog.orbinc","Length":5838,"Modified":639270225302945377}],"Blobs":["rain_glass.orbshader.b56f51172019f2b5.orbo"],"Data":{"Objects":[{"Key":"Builtin/Shaders/rain_glass.orbshader","TypeName":"Shader","BlobName":"rain_glass.orbshader.b56f51172019f2b5.orbo","Fields":[{"Name":"name","TypeName":"std::string","Value":"rain_glass"},{"Name":"vertexPath","TypeName":"std::string","Value":"Builtin/Shaders/rain_glass.orbshader"},{"Name":"fragmentPath","TypeName":"std::string","Value":"Builtin/Shaders/rain_glass.orbshader"},{"Name":"vertexSource","TypeName":"std::string","Value":"#version 430 core\nlayout(location = 0) in vec3 a_Position;\nlayout(location = 1) in vec3 a_Normal;\nlayout(location = 2) in vec2 a_TexCoord;\nuniform mat4 u_ViewProjection;\n//\u51E0\u4F55 ABI \u8F93\u5165\u3002\u9876\u70B9\u7740\u8272\u5668\u5305\u542B\u672C\u6587\u4EF6\u540E\uFF0C\u6309 ORBEDEN_GEOMETRY_MODE \u9009\u62E9\u9876\u70B9\u6570\u636E\u6765\u6E90\u3002\n//0 = Uniform \u5355\u7ED8\u5236\uFF0C1 = \u5B9E\u4F8B\u7ED8\u5236\uFF0C2 = \u5C55\u5F00\u9876\u70B9\uFF0C3 = \u62D6\u5C3E\u5B9E\u4F8B\u3002\n//\u5B8F\u7531\u7740\u8272\u5668\u5BFC\u5165\u5728 #version \u4E4B\u540E\u6CE8\u5165\uFF1B\u5355\u72EC\u7F16\u8BD1\u672C\u6587\u4EF6\u65F6\u6309\u5355\u7ED8\u5236\u5904\u7406\u3002\n#ifndef ORBEDEN_GEOMETRY_MODE\n#define ORBEDEN_GEOMETRY_MODE 0\n#endif\n\n#if ORBEDEN_GEOMETRY_MODE == 0\nuniform mat4 u_Model;\n//\u7BA1\u7EBF\u663E\u5F0F\u7ED1\u5B9A\u7684\u6BCF\u6279 tint \u4E0E\u56FE\u96C6\u53D8\u6362\uFF0C\u4E0D\u4F9D\u8D56 GL \u7684 uniform \u9ED8\u8BA4\u503C\nuniform vec4 u_InstanceTint;\nuniform vec4 u_InstanceUvRect;\n#elif ORBEDEN_GEOMETRY_MODE == 1\nlayout(location = 5) in vec4 a_InstanceModel0;\nlayout(location = 6) in vec4 a_InstanceModel1;\nlayout(location = 7) in vec4 a_InstanceModel2;\nlayout(location = 8) in vec4 a_InstanceModel3;\nlayout(location = 9) in vec4 a_InstanceNormal0;\nlayout(location = 10) in vec4 a_InstanceNormal1;\nlayout(location = 11) in vec4 a_InstanceNormal2;\nlayout(location = 12) in vec4 a_InstanceTint;\nlayout(location = 13) in vec4 a_InstanceUvRect;\n#elif ORBEDEN_GEOMETRY_MODE == 2\nlayout(location = 4) in vec4 a_ExpandedTint;\n#else\nlayout(location = 5) in vec4 a_TrailCorner0;\nlayout(location = 6) in vec4 a_TrailCorner1;\nlayout(location = 7) in vec4 a_TrailCorner2;\nlayout(location = 8) in vec4 a_TrailCorner3;\nlayout(location = 9) in vec4 a_TrailStartColor;\nlayout(location = 10) in vec4 a_TrailEndColor;\nlayout(location = 11) in vec4 a_TrailUvRange;\n#endif\n\n//\u4E16\u754C\u77E9\u9635\u3002\u5C55\u5F00\u9876\u70B9\u5DF2\u662F\u4E16\u754C\u7A7A\u95F4\uFF0C\u62D6\u5C3E\u5B9E\u4F8B\u4E0D\u7528\u6A21\u578B\u77E9\u9635\u3002\nmat4 OrbedenGetModel()\n{\n#if ORBEDEN_GEOMETRY_MODE == 0\n    return u_Model;\n#elif ORBEDEN_GEOMETRY_MODE == 1\n    return mat4(a_InstanceModel0, a_InstanceModel1, a_InstanceModel2, a_InstanceModel3);\n#else\n    return mat4(1.0);\n#endif\n}\n\n//\u6CD5\u7EBF\u77E9\u9635\u3002\u5355\u7ED8\u5236\u7531\u6A21\u578B\u77E9\u9635\u6C42\u9006\u8F6C\u7F6E\uFF0C\u5B9E\u4F8B\u7ED8\u5236\u8BFB CPU \u6C42\u597D\u7684\u4E09\u5217\u3002\nmat3 OrbedenGetNormalMatrix()\n{\n#if ORBEDEN_GEOMETRY_MODE == 0\n    return transpose(inverse(mat3(u_Model)));\n#elif ORBEDEN_GEOMETRY_MODE == 1\n    return mat3(a_InstanceNormal0.xyz, a_InstanceNormal1.xyz, a_InstanceNormal2.xyz);\n#else\n    return mat3(1.0);\n#endif\n}\n\n//\u6BCF\u5B9E\u4F8B\u6216\u6BCF\u7C92\u5B50\u7684 tint\uFF0C\u5DF2\u7ECF\u662F\u7EBF\u6027\u7A7A\u95F4\nvec4 OrbedenGetTint()\n{\n#if ORBEDEN_GEOMETRY_MODE == 0\n    return u_InstanceTint;\n#elif ORBEDEN_GEOMETRY_MODE == 1\n    return a_InstanceTint;\n#elif ORBEDEN_GEOMETRY_MODE == 2\n    return a_ExpandedTint;\n#else\n    return vec4(1.0);\n#endif\n}\n\n//\u56FE\u96C6 UV \u53D8\u6362\u3002\u5C55\u5F00\u9876\u70B9\u5728 CPU \u5DF2\u7ECF\u53D8\u6362\u5B8C\u6210\uFF0C\u8FD9\u91CC\u539F\u6837\u8FD4\u56DE\u3002\nvec2 OrbedenGetUv(vec2 uv)\n{\n#if ORBEDEN_GEOMETRY_MODE == 0\n    return uv * u_InstanceUvRect.zw \u002B u_InstanceUvRect.xy;\n#elif ORBEDEN_GEOMETRY_MODE == 1\n    return uv * a_InstanceUvRect.zw \u002B a_InstanceUvRect.xy;\n#elif ORBEDEN_GEOMETRY_MODE == 3\n    //\u62D6\u5C3E\u5B9E\u4F8B\uFF1A\u6CBF\u957F\u5EA6\u7684 uv \u7531\u5F27\u957F\u533A\u95F4\u7ED9\u51FA\uFF0C\u6A2A\u5411\u4ECD\u662F\u56DB\u8FB9\u5F62\u81EA\u8EAB\u7684 V\u3002\n    //\u7ED3\u679C\u5FC5\u987B\u4E0E\u5C55\u5F00\u8DEF\u5F84\u5199\u5728\u9876\u70B9\u91CC\u7684 (longitudinal, lateral) \u5B8C\u5168\u4E00\u81F4\u3002\n    return vec2(mix(a_TrailUvRange.x, a_TrailUvRange.y, uv.y), uv.x);\n#else\n    return uv;\n#endif\n}\n\n//\u62D6\u5C3E\u89D2\u70B9\u4F4D\u7F6E\u3002\u975E\u62D6\u5C3E\u6A21\u5F0F\u9000\u56DE\u666E\u901A\u9876\u70B9\uFF0C\u4FDD\u8BC1\u6240\u6709\u58F0\u660E\u53D8\u4F53\u90FD\u80FD\u7F16\u8BD1\u3002\nvec3 OrbedenGetTrailPosition(vec2 uv)\n{\n#if ORBEDEN_GEOMETRY_MODE == 3\n    vec4 startCorner = mix(a_TrailCorner0, a_TrailCorner1, uv.x);\n    vec4 endCorner = mix(a_TrailCorner3, a_TrailCorner2, uv.x);\n    return mix(startCorner, endCorner, uv.y).xyz;\n#else\n    return (OrbedenGetModel() * vec4(a_Position, 1.0)).xyz;\n#endif\n}\n\n//\u62D6\u5C3E\u989C\u8272\uFF0C\u6CBF\u957F\u5EA6\u5728\u4E24\u7AEF\u989C\u8272\u4E4B\u95F4\u63D2\u503C\nvec4 OrbedenGetTrailColor(vec2 uv)\n{\n#if ORBEDEN_GEOMETRY_MODE == 3\n    return mix(a_TrailStartColor, a_TrailEndColor, uv.y);\n#elif ORBEDEN_GEOMETRY_MODE == 2\n    return a_ExpandedTint;\n#else\n    return OrbedenGetTint();\n#endif\n}\nout vec2 v_TexCoord;\nout vec3 v_WorldPosition;\nout vec3 v_Normal;\nout vec4 v_ClipPosition;\nvoid main()\n{\n    v_TexCoord = OrbedenGetUv(a_TexCoord);\n    v_WorldPosition = (OrbedenGetMo\n... (truncated)"},{"Name":"fragmentSource","TypeName":"std::string","Value":"#version 430 core\nuniform sampler2D u_CameraColorTexture;\nuniform sampler2D u_CameraDepthTexture;\nuniform bool u_UseCameraTextures;\nuniform float u_CameraNearPlane;\nuniform float u_CameraFarPlane;\n\nvec2 GetCameraScreenUv(vec4 clipPosition)\n{\n    vec2 ndc = clipPosition.xy / max(clipPosition.w, 0.00001);\n    return ndc * 0.5 \u002B 0.5;\n}\n\nvec2 ClampCameraScreenUv(vec2 uv)\n{\n    return clamp(uv, vec2(0.001), vec2(0.999));\n}\n\nfloat LinearizeCameraDepth(float depth)\n{\n    float ndcDepth = depth * 2.0 - 1.0;\n    float denominator = u_CameraFarPlane \u002B u_CameraNearPlane - ndcDepth * (u_CameraFarPlane - u_CameraNearPlane);\n    return (2.0 * u_CameraNearPlane * u_CameraFarPlane) / max(denominator, 0.00001);\n}\n\nvec2 RejectForegroundCameraUv(vec2 baseUv, vec2 distortedUv, float surfaceDepth)\n{\n    float sceneDepth = LinearizeCameraDepth(texture(u_CameraDepthTexture, distortedUv).r);\n    float refractorDepth = LinearizeCameraDepth(surfaceDepth);\n    float depthBias = max(u_CameraNearPlane * 0.25, 0.01);\n    return sceneDepth \u002B depthBias \u003C refractorDepth ? baseUv : distortedUv;\n}\n\n//\u6309\u8868\u9762 UV \u65B9\u5411\u5C06\u504F\u79FB\u8F6C\u6362\u5230\u5C4F\u5E55\u7A7A\u95F4\nvec2 ConvertSurfaceOffsetToScreen(vec2 uv, vec2 offset)\n{\n    vec2 dx = dFdx(uv);\n    vec2 dy = dFdy(uv);\n    float determinant = dx.x * dy.y - dx.y * dy.x;\n    if (abs(determinant) \u003C 1e-12) return vec2(0.0);\n    vec2 pixels = vec2(dy.y * offset.x - dy.x * offset.y,\n        dx.x * offset.y - dx.y * offset.x) / determinant;\n    vec2 screenOffset = pixels / vec2(textureSize(u_CameraColorTexture, 0));\n    return screenOffset * min(1.0, 0.04 / max(length(screenOffset), 0.00001));\n}\n//\u751F\u6210\u4E8C\u7EF4\u683C\u70B9\u968F\u673A\u503C\nfloat HashCell(vec2 cell)\n{\n    vec3 value = fract(vec3(cell.xyx) * 0.1031);\n    value \u002B= dot(value, value.yzx \u002B 33.33);\n    return fract((value.x \u002B value.y) * value.z);\n}\n\n//\u63D2\u503C\u8FDE\u7EED\u566A\u58F0\nfloat SampleValueNoise(vec2 position)\n{\n    vec2 cell = floor(position);\n    vec2 blend = fract(position);\n    blend = blend * blend * (3.0 - 2.0 * blend);\n    return mix(mix(HashCell(cell), HashCell(cell \u002B vec2(1.0, 0.0)), blend.x),\n        mix(HashCell(cell \u002B vec2(0.0, 1.0)), HashCell(cell \u002B vec2(1.0)), blend.x), blend.y);\n}\n\n//\u53E0\u52A0\u4E09\u4E2A\u5C3A\u5EA6\u7684\u6E4D\u6D41\nfloat SampleFlowNoise(vec2 position)\n{\n    float result = 0.0;\n    float amplitude = 0.5714286;\n    mat2 rotation = mat2(0.8, 0.6, -0.6, 0.8);\n    for (int octave = 0; octave \u003C 3; \u002B\u002Boctave)\n    {\n        result \u002B= SampleValueNoise(position) * amplitude;\n        position = rotation * position * 2.03 \u002B vec2(17.1, 9.2);\n        amplitude *= 0.5;\n    }\n    return result;\n}\nin vec2 v_TexCoord;\nin vec3 v_WorldPosition;\nin vec3 v_Normal;\nin vec4 v_ClipPosition;\nuniform float u_Time;\nuniform vec3 u_CameraPosition;\nuniform vec3 u_LightDirection;\nuniform vec4 u_LightColor;\nuniform float u_LightIntensity;\nuniform float u_DropletScale;\nuniform float u_FlowSpeed;\nuniform float u_RefractionStrength;\nuniform float u_RainAmount;\nuniform float u_TrailStrength;\nuniform float u_Opacity;\nuniform float u_TintStrength;\nuniform vec4 u_TintColor;\nout vec4 FragColor;\n//\u8868\u9762\u7247\u5143\u7684\u7A7A\u6C14\u900F\u89C6\u4E0E\u6D53\u96FE\u5408\u6210\u3002\u4E24\u8005\u662F\u5404\u81EA\u72EC\u7ACB\u7684\u529F\u80FD\uFF0C\u5404\u770B\u5404\u7684\u5F00\u5173\uFF1A\n//\u7A7A\u6C14\u900F\u89C6\u67E5\u9762\u5411\u8FDC\u666F\u7684 L/Tau \u56FE\u96C6\uFF0C\u6D53\u96FE\u6309\u9AD8\u5EA6\u5256\u9762\u89E3\u6790\u79EF\u5206\uFF0C\u4E92\u4E0D\u5F15\u7528\u5BF9\u65B9\u7684 uniform\u3002\n//\u5BBF\u4E3B Shader \u9700\u8981\u58F0\u660E uniform vec3 u_CameraPosition; \u672C\u6587\u4EF6\u4E0E shadow_common \u4F9D\u8D56 u_LightDirection \u540C\u7406\u3002\n\nuniform sampler2D u_AtmosphereRadianceTexture;\nuniform sampler2D u_AtmosphereOpticalDepthTexture;\nuniform int u_AtmosphereFogEnabled;\nuniform float u_AtmosphereMaxDistanceKm;\nuniform float u_AtmosphereMetersPerWorldUnit;\nuniform vec4 u_AtmosphereViewport;\n//(\u8282\u70B9\u5BBD, \u8282\u70B9\u9AD8, \u8DDD\u79BB\u5C42\u6570, \u56FE\u96C6\u5217\u6570)\nuniform vec4 u_AtmosphereAtlas;\nuniform float u_AtmosphereCameraHeightKm;\nuniform vec3 u_AtmosphereCameraUp;\n\n//\u6D53\u96FE\u51FD\u6570\u5F15\u7528\u4E0A\u9762\u4E24\u4E2A\u76F8\u673A uniform\uFF0C\u5FC5\u987B\u58F0\u660E\u4E4B\u540E\u624D\u80FD\u5C55\u5F00\n//\u8D34\u5730\u6D53\u96FE\uFF1A\u5BC6\u5EA6\u6CBF\u9AD8\u5EA6\u5256\u9762\u53D8\u5316\uFF0C\u5149\u5B66\u539A\u5EA6\u6309\u8DEF\u5F84\u89E3\u6790\u79EF\u5206\u3002\n//\u4E0E\u7403\u5F62\u8584\u973E\u5206\u5F00\u914D\u7F6E\uFF0C\u8FD1\u8DDD\u6D53\u96FE\u4E0D\u4F9D\u8D56\u9762\u5411\u8FDC\u666F\u7684\u7A00\u758F\u67E5\u627E\u8868\u3002\n//\u5BBF\u4E3B Shader \u9700\u8981\u58F0\u660E u\n... (truncated)"},{"Name":"passes","TypeName":"List\u003CShaderPass\u003E","Value":"1 elements\nRainGlass"},{"Name":"textureSlots","TypeName":"List\u003CShaderTextureSlot\u003E","Value":"0 elements"},{"Name":"colorSlots","TypeName":"List\u003CShaderColorSlot\u003E","Value":"1 elements"},{"Name":"floatSlots","TypeName":"List\u003CShaderFloatSlot\u003E","Value":"7 elements"}]}],"Messages":[],"IsStale":false,"IsLoading":false},"Runtime":null}