{"Version":7,"Source":"Builtin/Shaders/refraction.orbshader","Settings":{},"Dependencies":[{"Path":"Builtin/Shaders/refraction.orbshader","Length":1757,"Modified":639261748409327085},{"Path":"Builtin/geometry_input.orbinc","Length":3854,"Modified":639261610040732462},{"Path":"Builtin/camera_texture_common.orbinc","Length":1075,"Modified":639246226177031012}],"Blobs":["refraction.orbshader.86bbaae275de82cb.orbo"],"Data":{"Objects":[{"Key":"Builtin/Shaders/refraction.orbshader","TypeName":"Shader","BlobName":"refraction.orbshader.86bbaae275de82cb.orbo","Fields":[{"Name":"name","TypeName":"std::string","Value":"refraction"},{"Name":"vertexPath","TypeName":"std::string","Value":"Builtin/Shaders/refraction.orbshader"},{"Name":"fragmentPath","TypeName":"std::string","Value":"Builtin/Shaders/refraction.orbshader"},{"Name":"vertexSource","TypeName":"std::string","Value":"#version 430 core\n\nlayout(location = 0) in vec3 a_Position;\nlayout(location = 1) in vec3 a_Normal;\nlayout(location = 2) in vec2 a_TexCoord;\nlayout(location = 3) in vec3 a_Tangent;\n\nuniform mat4 u_ViewProjection;\n\n//\u51E0\u4F55 ABI \u8F93\u5165\u3002\u9876\u70B9\u7740\u8272\u5668\u5305\u542B\u672C\u6587\u4EF6\u540E\uFF0C\u6309 ORBEDEN_GEOMETRY_MODE \u9009\u62E9\u9876\u70B9\u6570\u636E\u6765\u6E90\u3002\n//0 = Uniform \u5355\u7ED8\u5236\uFF0C1 = \u5B9E\u4F8B\u7ED8\u5236\uFF0C2 = \u5C55\u5F00\u9876\u70B9\uFF0C3 = \u62D6\u5C3E\u5B9E\u4F8B\u3002\n//\u5B8F\u7531\u7740\u8272\u5668\u5BFC\u5165\u5728 #version \u4E4B\u540E\u6CE8\u5165\uFF1B\u5355\u72EC\u7F16\u8BD1\u672C\u6587\u4EF6\u65F6\u6309\u5355\u7ED8\u5236\u5904\u7406\u3002\n#ifndef ORBEDEN_GEOMETRY_MODE\n#define ORBEDEN_GEOMETRY_MODE 0\n#endif\n\n#if ORBEDEN_GEOMETRY_MODE == 0\nuniform mat4 u_Model;\n//\u7BA1\u7EBF\u663E\u5F0F\u7ED1\u5B9A\u7684\u6BCF\u6279 tint \u4E0E\u56FE\u96C6\u53D8\u6362\uFF0C\u4E0D\u4F9D\u8D56 GL \u7684 uniform \u9ED8\u8BA4\u503C\nuniform vec4 u_InstanceTint;\nuniform vec4 u_InstanceUvRect;\n#elif ORBEDEN_GEOMETRY_MODE == 1\nlayout(location = 5) in vec4 a_InstanceModel0;\nlayout(location = 6) in vec4 a_InstanceModel1;\nlayout(location = 7) in vec4 a_InstanceModel2;\nlayout(location = 8) in vec4 a_InstanceModel3;\nlayout(location = 9) in vec4 a_InstanceNormal0;\nlayout(location = 10) in vec4 a_InstanceNormal1;\nlayout(location = 11) in vec4 a_InstanceNormal2;\nlayout(location = 12) in vec4 a_InstanceTint;\nlayout(location = 13) in vec4 a_InstanceUvRect;\n#elif ORBEDEN_GEOMETRY_MODE == 2\nlayout(location = 4) in vec4 a_ExpandedTint;\n#else\nlayout(location = 5) in vec4 a_TrailCorner0;\nlayout(location = 6) in vec4 a_TrailCorner1;\nlayout(location = 7) in vec4 a_TrailCorner2;\nlayout(location = 8) in vec4 a_TrailCorner3;\nlayout(location = 9) in vec4 a_TrailStartColor;\nlayout(location = 10) in vec4 a_TrailEndColor;\nlayout(location = 11) in vec4 a_TrailUvRange;\n#endif\n\n//\u4E16\u754C\u77E9\u9635\u3002\u5C55\u5F00\u9876\u70B9\u5DF2\u662F\u4E16\u754C\u7A7A\u95F4\uFF0C\u62D6\u5C3E\u5B9E\u4F8B\u4E0D\u7528\u6A21\u578B\u77E9\u9635\u3002\nmat4 OrbedenGetModel()\n{\n#if ORBEDEN_GEOMETRY_MODE == 0\n    return u_Model;\n#elif ORBEDEN_GEOMETRY_MODE == 1\n    return mat4(a_InstanceModel0, a_InstanceModel1, a_InstanceModel2, a_InstanceModel3);\n#else\n    return mat4(1.0);\n#endif\n}\n\n//\u6CD5\u7EBF\u77E9\u9635\u3002\u5355\u7ED8\u5236\u7531\u6A21\u578B\u77E9\u9635\u6C42\u9006\u8F6C\u7F6E\uFF0C\u5B9E\u4F8B\u7ED8\u5236\u8BFB CPU \u6C42\u597D\u7684\u4E09\u5217\u3002\nmat3 OrbedenGetNormalMatrix()\n{\n#if ORBEDEN_GEOMETRY_MODE == 0\n    return transpose(inverse(mat3(u_Model)));\n#elif ORBEDEN_GEOMETRY_MODE == 1\n    return mat3(a_InstanceNormal0.xyz, a_InstanceNormal1.xyz, a_InstanceNormal2.xyz);\n#else\n    return mat3(1.0);\n#endif\n}\n\n//\u6BCF\u5B9E\u4F8B\u6216\u6BCF\u7C92\u5B50\u7684 tint\uFF0C\u5DF2\u7ECF\u662F\u7EBF\u6027\u7A7A\u95F4\nvec4 OrbedenGetTint()\n{\n#if ORBEDEN_GEOMETRY_MODE == 0\n    return u_InstanceTint;\n#elif ORBEDEN_GEOMETRY_MODE == 1\n    return a_InstanceTint;\n#elif ORBEDEN_GEOMETRY_MODE == 2\n    return a_ExpandedTint;\n#else\n    return vec4(1.0);\n#endif\n}\n\n//\u56FE\u96C6 UV \u53D8\u6362\u3002\u5C55\u5F00\u9876\u70B9\u5728 CPU \u5DF2\u7ECF\u53D8\u6362\u5B8C\u6210\uFF0C\u8FD9\u91CC\u539F\u6837\u8FD4\u56DE\u3002\nvec2 OrbedenGetUv(vec2 uv)\n{\n#if ORBEDEN_GEOMETRY_MODE == 0\n    return uv * u_InstanceUvRect.zw \u002B u_InstanceUvRect.xy;\n#elif ORBEDEN_GEOMETRY_MODE == 1\n    return uv * a_InstanceUvRect.zw \u002B a_InstanceUvRect.xy;\n#elif ORBEDEN_GEOMETRY_MODE == 3\n    //\u62D6\u5C3E\u5B9E\u4F8B\uFF1A\u6CBF\u957F\u5EA6\u7684 uv \u7531\u5F27\u957F\u533A\u95F4\u7ED9\u51FA\uFF0C\u6A2A\u5411\u4ECD\u662F\u56DB\u8FB9\u5F62\u81EA\u8EAB\u7684 V\u3002\n    //\u7ED3\u679C\u5FC5\u987B\u4E0E\u5C55\u5F00\u8DEF\u5F84\u5199\u5728\u9876\u70B9\u91CC\u7684 (longitudinal, lateral) \u5B8C\u5168\u4E00\u81F4\u3002\n    return vec2(mix(a_TrailUvRange.x, a_TrailUvRange.y, uv.y), uv.x);\n#else\n    return uv;\n#endif\n}\n\n//\u62D6\u5C3E\u89D2\u70B9\u4F4D\u7F6E\u3002\u975E\u62D6\u5C3E\u6A21\u5F0F\u9000\u56DE\u666E\u901A\u9876\u70B9\uFF0C\u4FDD\u8BC1\u6240\u6709\u58F0\u660E\u53D8\u4F53\u90FD\u80FD\u7F16\u8BD1\u3002\nvec3 OrbedenGetTrailPosition(vec2 uv)\n{\n#if ORBEDEN_GEOMETRY_MODE == 3\n    vec4 startCorner = mix(a_TrailCorner0, a_TrailCorner1, uv.x);\n    vec4 endCorner = mix(a_TrailCorner3, a_TrailCorner2, uv.x);\n    return mix(startCorner, endCorner, uv.y).xyz;\n#else\n    return (OrbedenGetModel() * vec4(a_Position, 1.0)).xyz;\n#endif\n}\n\n//\u62D6\u5C3E\u989C\u8272\uFF0C\u6CBF\u957F\u5EA6\u5728\u4E24\u7AEF\u989C\u8272\u4E4B\u95F4\u63D2\u503C\nvec4 OrbedenGetTrailColor(vec2 uv)\n{\n#if ORBEDEN_GEOMETRY_MODE == 3\n    return mix(a_TrailStartColor, a_TrailEndColor, uv.y);\n#elif ORBEDEN_GEOMETRY_MODE == 2\n    return a_ExpandedTint;\n#else\n    return OrbedenGetTint();\n#endif\n}\n\nout vec3 v_WorldNormal;\nout vec4 v_ClipPosition;\n\nvoid main()\n{\n    v_WorldNormal = mat3(OrbedenGetModel()) * a_Normal;\n    v_ClipPosition \n... (truncated)"},{"Name":"fragmentSource","TypeName":"std::string","Value":"#version 430 core\n\nuniform sampler2D u_CameraColorTexture;\nuniform sampler2D u_CameraDepthTexture;\nuniform bool u_UseCameraTextures;\nuniform float u_CameraNearPlane;\nuniform float u_CameraFarPlane;\n\nvec2 GetCameraScreenUv(vec4 clipPosition)\n{\n    vec2 ndc = clipPosition.xy / max(clipPosition.w, 0.00001);\n    return ndc * 0.5 \u002B 0.5;\n}\n\nvec2 ClampCameraScreenUv(vec2 uv)\n{\n    return clamp(uv, vec2(0.001), vec2(0.999));\n}\n\nfloat LinearizeCameraDepth(float depth)\n{\n    float ndcDepth = depth * 2.0 - 1.0;\n    float denominator = u_CameraFarPlane \u002B u_CameraNearPlane - ndcDepth * (u_CameraFarPlane - u_CameraNearPlane);\n    return (2.0 * u_CameraNearPlane * u_CameraFarPlane) / max(denominator, 0.00001);\n}\n\nvec2 RejectForegroundCameraUv(vec2 baseUv, vec2 distortedUv, float surfaceDepth)\n{\n    float sceneDepth = LinearizeCameraDepth(texture(u_CameraDepthTexture, distortedUv).r);\n    float refractorDepth = LinearizeCameraDepth(surfaceDepth);\n    float depthBias = max(u_CameraNearPlane * 0.25, 0.01);\n    return sceneDepth \u002B depthBias \u003C refractorDepth ? baseUv : distortedUv;\n}\n\nin vec3 v_WorldNormal;\nin vec4 v_ClipPosition;\n\nuniform vec4 u_TintColor;\nuniform float u_RefractionStrength;\nuniform float u_Opacity;\n\nout vec4 FragColor;\n\nvoid main()\n{\n    float opacity = clamp(u_Opacity, 0.0, 1.0);\n    //\u6298\u5C04\u961F\u5217\u5728\u76F8\u673A\u989C\u8272\u53EF\u7528\u524D\u5148\u753B\u4E00\u6B21\uFF0C\u6B64\u65F6\u9000\u5316\u6210\u4E00\u5C42\u5F88\u6DE1\u7684\u67D3\u8272\n    if (!u_UseCameraTextures)\n    {\n        FragColor = vec4(u_TintColor.rgb, opacity * 0.15);\n        return;\n    }\n\n    //\u53EA\u53D6\u5C4F\u5E55\u5E73\u9762\u5185\u7684\u6CD5\u7EBF\u5206\u91CF\u6270\u52A8 UV\uFF1A\u80CC\u5411\u76F8\u673A\u7684\u5206\u91CF\u4F1A\u628A\u91C7\u6837\u62C9\u51FA\u753B\u9762\n    vec2 screenUv = ClampCameraScreenUv(GetCameraScreenUv(v_ClipPosition));\n    vec3 normal = normalize(v_WorldNormal);\n    vec2 offset = vec2(normal.x, normal.y) * max(u_RefractionStrength, 0.0);\n    vec2 distortedUv = ClampCameraScreenUv(screenUv \u002B offset);\n    //\u80CC\u666F\u6BD4\u6298\u5C04\u9762\u66F4\u8FD1\u65F6\u653E\u5F03\u504F\u79FB\uFF0C\u907F\u514D\u628A\u524D\u666F\u7269\u4F53\u7CCA\u5230\u8868\u9762\u4E0A\n    distortedUv = RejectForegroundCameraUv(screenUv, distortedUv, gl_FragCoord.z);\n\n    vec3 sceneColor = texture(u_CameraColorTexture, distortedUv).rgb;\n    FragColor = vec4(mix(sceneColor, sceneColor * u_TintColor.rgb, 0.3), opacity);\n}\n"},{"Name":"passes","TypeName":"List\u003CShaderPass\u003E","Value":"1 elements\nDefault"},{"Name":"textureSlots","TypeName":"List\u003CShaderTextureSlot\u003E","Value":"0 elements"},{"Name":"colorSlots","TypeName":"List\u003CShaderColorSlot\u003E","Value":"1 elements"},{"Name":"floatSlots","TypeName":"List\u003CShaderFloatSlot\u003E","Value":"2 elements"}]}],"Messages":[],"IsStale":false,"IsLoading":false},"Runtime":null}