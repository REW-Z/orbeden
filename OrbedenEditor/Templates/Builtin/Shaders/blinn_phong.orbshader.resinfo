{"Version":7,"Source":"Builtin/Shaders/blinn_phong.orbshader","Settings":{},"Dependencies":[{"Path":"Builtin/Shaders/blinn_phong.orbshader","Length":3479,"Modified":639270225302036209},{"Path":"Builtin/geometry_input.orbinc","Length":3854,"Modified":639261610040732462},{"Path":"Builtin/shadow_common.orbinc","Length":4214,"Modified":639270225302945377},{"Path":"Builtin/environment_reflection.orbinc","Length":841,"Modified":639261588016697074},{"Path":"Builtin/atmosphere_sampling.orbinc","Length":5341,"Modified":639270225302935360},{"Path":"Builtin/dense_fog.orbinc","Length":5838,"Modified":639270225302945377}],"Blobs":["blinn_phong.orbshader.8b40871342033ac4.orbo"],"Data":{"Objects":[{"Key":"Builtin/Shaders/blinn_phong.orbshader","TypeName":"Shader","BlobName":"blinn_phong.orbshader.8b40871342033ac4.orbo","Fields":[{"Name":"name","TypeName":"std::string","Value":"blinn_phong"},{"Name":"vertexPath","TypeName":"std::string","Value":"Builtin/Shaders/blinn_phong.orbshader"},{"Name":"fragmentPath","TypeName":"std::string","Value":"Builtin/Shaders/blinn_phong.orbshader"},{"Name":"vertexSource","TypeName":"std::string","Value":"#version 430 core\n\nlayout(location = 0) in vec3 a_Position;\nlayout(location = 1) in vec3 a_Normal;\nlayout(location = 2) in vec2 a_TexCoord;\nlayout(location = 3) in vec3 a_Tangent;\n\nuniform mat4 u_ViewProjection;\n//\u51E0\u4F55 ABI \u8F93\u5165\u3002\u9876\u70B9\u7740\u8272\u5668\u5305\u542B\u672C\u6587\u4EF6\u540E\uFF0C\u6309 ORBEDEN_GEOMETRY_MODE \u9009\u62E9\u9876\u70B9\u6570\u636E\u6765\u6E90\u3002\n//0 = Uniform \u5355\u7ED8\u5236\uFF0C1 = \u5B9E\u4F8B\u7ED8\u5236\uFF0C2 = \u5C55\u5F00\u9876\u70B9\uFF0C3 = \u62D6\u5C3E\u5B9E\u4F8B\u3002\n//\u5B8F\u7531\u7740\u8272\u5668\u5BFC\u5165\u5728 #version \u4E4B\u540E\u6CE8\u5165\uFF1B\u5355\u72EC\u7F16\u8BD1\u672C\u6587\u4EF6\u65F6\u6309\u5355\u7ED8\u5236\u5904\u7406\u3002\n#ifndef ORBEDEN_GEOMETRY_MODE\n#define ORBEDEN_GEOMETRY_MODE 0\n#endif\n\n#if ORBEDEN_GEOMETRY_MODE == 0\nuniform mat4 u_Model;\n//\u7BA1\u7EBF\u663E\u5F0F\u7ED1\u5B9A\u7684\u6BCF\u6279 tint \u4E0E\u56FE\u96C6\u53D8\u6362\uFF0C\u4E0D\u4F9D\u8D56 GL \u7684 uniform \u9ED8\u8BA4\u503C\nuniform vec4 u_InstanceTint;\nuniform vec4 u_InstanceUvRect;\n#elif ORBEDEN_GEOMETRY_MODE == 1\nlayout(location = 5) in vec4 a_InstanceModel0;\nlayout(location = 6) in vec4 a_InstanceModel1;\nlayout(location = 7) in vec4 a_InstanceModel2;\nlayout(location = 8) in vec4 a_InstanceModel3;\nlayout(location = 9) in vec4 a_InstanceNormal0;\nlayout(location = 10) in vec4 a_InstanceNormal1;\nlayout(location = 11) in vec4 a_InstanceNormal2;\nlayout(location = 12) in vec4 a_InstanceTint;\nlayout(location = 13) in vec4 a_InstanceUvRect;\n#elif ORBEDEN_GEOMETRY_MODE == 2\nlayout(location = 4) in vec4 a_ExpandedTint;\n#else\nlayout(location = 5) in vec4 a_TrailCorner0;\nlayout(location = 6) in vec4 a_TrailCorner1;\nlayout(location = 7) in vec4 a_TrailCorner2;\nlayout(location = 8) in vec4 a_TrailCorner3;\nlayout(location = 9) in vec4 a_TrailStartColor;\nlayout(location = 10) in vec4 a_TrailEndColor;\nlayout(location = 11) in vec4 a_TrailUvRange;\n#endif\n\n//\u4E16\u754C\u77E9\u9635\u3002\u5C55\u5F00\u9876\u70B9\u5DF2\u662F\u4E16\u754C\u7A7A\u95F4\uFF0C\u62D6\u5C3E\u5B9E\u4F8B\u4E0D\u7528\u6A21\u578B\u77E9\u9635\u3002\nmat4 OrbedenGetModel()\n{\n#if ORBEDEN_GEOMETRY_MODE == 0\n    return u_Model;\n#elif ORBEDEN_GEOMETRY_MODE == 1\n    return mat4(a_InstanceModel0, a_InstanceModel1, a_InstanceModel2, a_InstanceModel3);\n#else\n    return mat4(1.0);\n#endif\n}\n\n//\u6CD5\u7EBF\u77E9\u9635\u3002\u5355\u7ED8\u5236\u7531\u6A21\u578B\u77E9\u9635\u6C42\u9006\u8F6C\u7F6E\uFF0C\u5B9E\u4F8B\u7ED8\u5236\u8BFB CPU \u6C42\u597D\u7684\u4E09\u5217\u3002\nmat3 OrbedenGetNormalMatrix()\n{\n#if ORBEDEN_GEOMETRY_MODE == 0\n    return transpose(inverse(mat3(u_Model)));\n#elif ORBEDEN_GEOMETRY_MODE == 1\n    return mat3(a_InstanceNormal0.xyz, a_InstanceNormal1.xyz, a_InstanceNormal2.xyz);\n#else\n    return mat3(1.0);\n#endif\n}\n\n//\u6BCF\u5B9E\u4F8B\u6216\u6BCF\u7C92\u5B50\u7684 tint\uFF0C\u5DF2\u7ECF\u662F\u7EBF\u6027\u7A7A\u95F4\nvec4 OrbedenGetTint()\n{\n#if ORBEDEN_GEOMETRY_MODE == 0\n    return u_InstanceTint;\n#elif ORBEDEN_GEOMETRY_MODE == 1\n    return a_InstanceTint;\n#elif ORBEDEN_GEOMETRY_MODE == 2\n    return a_ExpandedTint;\n#else\n    return vec4(1.0);\n#endif\n}\n\n//\u56FE\u96C6 UV \u53D8\u6362\u3002\u5C55\u5F00\u9876\u70B9\u5728 CPU \u5DF2\u7ECF\u53D8\u6362\u5B8C\u6210\uFF0C\u8FD9\u91CC\u539F\u6837\u8FD4\u56DE\u3002\nvec2 OrbedenGetUv(vec2 uv)\n{\n#if ORBEDEN_GEOMETRY_MODE == 0\n    return uv * u_InstanceUvRect.zw \u002B u_InstanceUvRect.xy;\n#elif ORBEDEN_GEOMETRY_MODE == 1\n    return uv * a_InstanceUvRect.zw \u002B a_InstanceUvRect.xy;\n#elif ORBEDEN_GEOMETRY_MODE == 3\n    //\u62D6\u5C3E\u5B9E\u4F8B\uFF1A\u6CBF\u957F\u5EA6\u7684 uv \u7531\u5F27\u957F\u533A\u95F4\u7ED9\u51FA\uFF0C\u6A2A\u5411\u4ECD\u662F\u56DB\u8FB9\u5F62\u81EA\u8EAB\u7684 V\u3002\n    //\u7ED3\u679C\u5FC5\u987B\u4E0E\u5C55\u5F00\u8DEF\u5F84\u5199\u5728\u9876\u70B9\u91CC\u7684 (longitudinal, lateral) \u5B8C\u5168\u4E00\u81F4\u3002\n    return vec2(mix(a_TrailUvRange.x, a_TrailUvRange.y, uv.y), uv.x);\n#else\n    return uv;\n#endif\n}\n\n//\u62D6\u5C3E\u89D2\u70B9\u4F4D\u7F6E\u3002\u975E\u62D6\u5C3E\u6A21\u5F0F\u9000\u56DE\u666E\u901A\u9876\u70B9\uFF0C\u4FDD\u8BC1\u6240\u6709\u58F0\u660E\u53D8\u4F53\u90FD\u80FD\u7F16\u8BD1\u3002\nvec3 OrbedenGetTrailPosition(vec2 uv)\n{\n#if ORBEDEN_GEOMETRY_MODE == 3\n    vec4 startCorner = mix(a_TrailCorner0, a_TrailCorner1, uv.x);\n    vec4 endCorner = mix(a_TrailCorner3, a_TrailCorner2, uv.x);\n    return mix(startCorner, endCorner, uv.y).xyz;\n#else\n    return (OrbedenGetModel() * vec4(a_Position, 1.0)).xyz;\n#endif\n}\n\n//\u62D6\u5C3E\u989C\u8272\uFF0C\u6CBF\u957F\u5EA6\u5728\u4E24\u7AEF\u989C\u8272\u4E4B\u95F4\u63D2\u503C\nvec4 OrbedenGetTrailColor(vec2 uv)\n{\n#if ORBEDEN_GEOMETRY_MODE == 3\n    return mix(a_TrailStartColor, a_TrailEndColor, uv.y);\n#elif ORBEDEN_GEOMETRY_MODE == 2\n    return a_ExpandedTint;\n#else\n    return OrbedenGetTint();\n#endif\n}\n\nout vec3 v_WorldPosition;\nout vec3 v_Normal;\nout vec2 v_TexCoord;\nout vec4 v_Tint;\n\nvoid main()\n{\n    mat4 model = OrbedenGetModel();\n    ve\n... (truncated)"},{"Name":"fragmentSource","TypeName":"std::string","Value":"#version 430 core\n\nin vec3 v_WorldPosition;\nin vec3 v_Normal;\nin vec2 v_TexCoord;\nin vec4 v_Tint;\n\nuniform vec3 u_CameraPosition;\nuniform vec4 u_AmbientColor;\nuniform vec4 u_DiffuseColor;\nuniform vec4 u_SpecularColor;\nuniform float u_Shininess;\nuniform vec3 u_LightDirection;\nuniform vec4 u_LightColor;\nuniform float u_LightIntensity;\nuniform bool u_HasDiffuseTexture;\nuniform sampler2D u_DiffuseTexture;\nuniform sampler2D u_ShadowMap;\nuniform bool u_UseShadowMap;\nuniform bool u_ReceiveShadows;\nuniform int u_ShadowCascadeCount;\nuniform mat4 u_ShadowView;\nuniform mat4 u_ShadowMatrices[6];\nuniform vec4 u_ShadowRects[6];\nuniform vec4 u_ShadowParams[6];\nuniform float u_ShadowBias;\nuniform float u_ShadowNormalBias;\nuniform float u_ShadowStrength;\n\n//\u9009\u62E9\u89C6\u6DF1\u5EA6\u5BF9\u5E94\u7EA7\u8054\nint FindShadowCascade(float viewDepth)\n{\n    for (int index = 0; index \u003C u_ShadowCascadeCount; \u002B\u002Bindex)\n        if (viewDepth \u003C= u_ShadowParams[index].x) return index;\n    return -1;\n}\n\n//\u8FC7\u6EE4\u5F53\u524D\u7EA7\u8054\u5E76\u4FEE\u6B63\u63A5\u6536\u9762\u659C\u7387\nfloat SampleShadowCascade(int index, vec3 position, vec3 normal, vec3 worldDx, vec3 worldDy)\n{\n    vec4 parameters = u_ShadowParams[index];\n    vec3 light = normalize(-u_LightDirection);\n    float slope = sqrt(max(0.0, 1.0 - pow(clamp(dot(normal, light), 0.0, 1.0), 2.0)));\n    vec3 offsetPosition = position \u002B normal * (u_ShadowNormalBias * parameters.z * slope);\n    vec3 projected = (u_ShadowMatrices[index] * vec4(offsetPosition, 1.0)).xyz * 0.5 \u002B 0.5;\n    if (any(lessThan(projected, vec3(0.0))) || any(greaterThan(projected, vec3(1.0)))) return 0.0;\n\n    //\u5C06\u4E16\u754C\u4F4D\u7F6E\u5BFC\u6570\u8F6C\u6362\u4E3A atlas \u6DF1\u5EA6\u68AF\u5EA6\n    vec4 rect = u_ShadowRects[index];\n    vec3 dx = (u_ShadowMatrices[index] * vec4(worldDx, 0.0)).xyz * 0.5;\n    vec3 dy = (u_ShadowMatrices[index] * vec4(worldDy, 0.0)).xyz * 0.5;\n    dx.xy *= rect.xy;\n    dy.xy *= rect.xy;\n    float determinant = dx.x * dy.y - dx.y * dy.x;\n    vec2 gradient = vec2(0.0);\n    if (abs(determinant) \u003E 1e-12)\n        gradient = vec2(dy.y * dx.z - dx.y * dy.z, dx.x * dy.z - dy.x * dx.z) / determinant;\n    if (any(isnan(gradient)) || any(isinf(gradient))) gradient = vec2(0.0);\n\n    //\u5728\u5355\u683C atlas \u5185\u8FDB\u884C\u8FDE\u7EED tent PCF\n    ivec2 atlasSize = textureSize(u_ShadowMap, 0);\n    vec2 uv = projected.xy * rect.xy \u002B rect.zw;\n    vec2 pixel = uv * vec2(atlasSize) - 0.5;\n    ivec2 base = ivec2(floor(pixel));\n    vec2 fraction = fract(pixel);\n    ivec2 minimum = ivec2(round(rect.zw * vec2(atlasSize)));\n    ivec2 maximum = minimum \u002B ivec2(round(rect.xy * vec2(atlasSize))) - 1;\n    float bias = u_ShadowBias / max(parameters.w, 1e-6);\n    float result = 0.0;\n    float weightSum = 0.0;\n    for (int y = -1; y \u003C= 2; \u002B\u002By)\n    {\n        for (int x = -1; x \u003C= 2; \u002B\u002Bx)\n        {\n            vec2 weight = max(vec2(0.0), 2.0 - abs(vec2(x, y) - fraction));\n            float tapWeight = weight.x * weight.y;\n            ivec2 tap = clamp(base \u002B ivec2(x, y), minimum, maximum);\n            vec2 tapUv = (vec2(tap) \u002B 0.5) / vec2(atlasSize);\n            float receiverDepth = projected.z \u002B dot(gradient, tapUv - uv) - bias;\n            result \u002B= (receiverDepth \u003E texelFetch(u_ShadowMap, tap, 0).r ? 1.0 : 0.0) * tapWeight;\n            weightSum \u002B= tapWeight;\n        }\n    }\n    return result / max(weightSum, 1e-6);\n}\n\n//\u8BA1\u7B97\u592A\u9633\u906E\u6321\u4E0E\u7EA7\u8054\u8FC7\u6E21\nfloat SampleShadow(vec3 worldPosition, vec3 surfaceNormal)\n{\n    //\u5728\u5206\u652F\u524D\u8BFB\u53D6\u7247\u5143\u5BFC\u6570\n    vec3 worldDx = dFdx(worldPosition);\n    vec3 worldDy = dFdy(worldPosition);\n    vec3 crossed = cross(worldDx, worldDy);\n    float normalLength = length(crossed);\n    vec3 normal = normalLength \u003E 1e-10 ? crossed / normalLength : normalize(surfaceNormal);\n    if (dot(normal, surfaceNormal) \u003C 0.0) normal = -normal;\n    if (!u_UseShadowMap || !u_ReceiveShadows || u_ShadowCascadeCount == 0) return 0.0;\n    float viewDepth = -(u_ShadowView * vec4(worldPosition, 1.0)).z;\n    int index = FindShadowCascade(viewDepth);\n    if (index \u003C 0 || viewDepth \u003C 0.0) return 0.0;\n    float shadow = SampleShadowCascade(index, worldPosition, normal, worldDx, worldDy);\n    vec4 parameters = u_ShadowParams[in\n... (truncated)"},{"Name":"passes","TypeName":"List\u003CShaderPass\u003E","Value":"1 elements\nDefault"},{"Name":"textureSlots","TypeName":"List\u003CShaderTextureSlot\u003E","Value":"1 elements"},{"Name":"colorSlots","TypeName":"List\u003CShaderColorSlot\u003E","Value":"2 elements"},{"Name":"floatSlots","TypeName":"List\u003CShaderFloatSlot\u003E","Value":"1 elements"}]}],"Messages":[],"IsStale":false,"IsLoading":false},"Runtime":null}