{"Version":7,"Source":"Builtin/Shaders/skybox.orbshader","Settings":{},"Dependencies":[{"Path":"Builtin/Shaders/skybox.orbshader","Length":1108,"Modified":639270225302275779},{"Path":"Builtin/dense_fog.orbinc","Length":5838,"Modified":639270225302945377}],"Blobs":["skybox.orbshader.65811bb43f9e6a4e.orbo"],"Data":{"Objects":[{"Key":"Builtin/Shaders/skybox.orbshader","TypeName":"Shader","BlobName":"skybox.orbshader.65811bb43f9e6a4e.orbo","Fields":[{"Name":"name","TypeName":"std::string","Value":"skybox"},{"Name":"vertexPath","TypeName":"std::string","Value":"Builtin/Shaders/skybox.orbshader"},{"Name":"fragmentPath","TypeName":"std::string","Value":"Builtin/Shaders/skybox.orbshader"},{"Name":"vertexSource","TypeName":"std::string","Value":"#version 430 core\n\nlayout(location = 0) in vec3 a_Position;\n\nuniform mat4 u_ViewProjection;\n\nout vec3 v_TexCoord;\n\nvoid main()\n{\n    v_TexCoord = a_Position;\n    vec4 position = u_ViewProjection * vec4(a_Position, 1.0);\n    gl_Position = position.xyww;\n}\n\n"},{"Name":"fragmentSource","TypeName":"std::string","Value":"#version 430 core\n\nin vec3 v_TexCoord;\n\nuniform samplerCube u_SkyboxTexture;\nuniform float u_AtmosphereCameraHeightKm;\nuniform vec3 u_AtmosphereCameraUp;\n//\u8D34\u5730\u6D53\u96FE\uFF1A\u5BC6\u5EA6\u6CBF\u9AD8\u5EA6\u5256\u9762\u53D8\u5316\uFF0C\u5149\u5B66\u539A\u5EA6\u6309\u8DEF\u5F84\u89E3\u6790\u79EF\u5206\u3002\n//\u4E0E\u7403\u5F62\u8584\u973E\u5206\u5F00\u914D\u7F6E\uFF0C\u8FD1\u8DDD\u6D53\u96FE\u4E0D\u4F9D\u8D56\u9762\u5411\u8FDC\u666F\u7684\u7A00\u758F\u67E5\u627E\u8868\u3002\n//\u5BBF\u4E3B Shader \u9700\u8981\u58F0\u660E uniform float u_AtmosphereCameraHeightKm; \u4E0E uniform vec3 u_AtmosphereCameraUp;\n//\n//\u9AD8\u5EA6\u6309\u5E73\u5730\u8FD1\u4F3C\u6CBF\u5C04\u7EBF\u7EBF\u6027\u53D8\u5316\uFF1Ah(s) = \u76F8\u673A\u9AD8\u5EA6 \u002B mu * s\u3002\u4ECB\u8D28\u7684\u5C3A\u5EA6\uFF08\u80FD\u89C1\u5EA6\u51E0\u5341\u7C73\u5230\u51E0\u516C\u91CC\u3001\n//\u96FE\u9876\u51E0\u5341\u7C73\u5230\u51E0\u516C\u91CC\uFF09\u8FDC\u5C0F\u4E8E\u5730\u7403\u534A\u5F84 6371 km\uFF0C\u4E24\u8005\u7684\u5DEE\u522B\u53EA\u5728\u0022\u76F8\u673A\u9AD8\u4E8E\u96FE\u9876\u5E76\u4FEF\u89C6\u8FDC\u5904\u0022\u65F6\u624D\u53EF\u89C1\uFF0C\n//\u5C42\u5185\u89C6\u7EBF\u5728 200 km \u4EE5\u5185\u4E0D\u53EF\u5206\u8FA8\u3002\u6362\u6765\u7684\u662F\u6574\u4E2A\u5256\u9762\u90FD\u6709\u521D\u7B49\u539F\u51FD\u6570\uFF1A\u9010\u50CF\u7D20\u53EA\u5269\u4E00\u6B21\u51FD\u6570\u6C42\u503C\uFF0C\n//\u6CA1\u6709\u6C42\u79EF\u3001\u6CA1\u6709\u8FB9\u754C\u6C42\u4EA4\uFF0C\u4EE3\u7801\u91CF\u964D\u5230\u539F\u6765\u7684\u767E\u5206\u4E4B\u51E0\u2014\u2014\u8FD9\u4E00\u6761\u662F\u6027\u80FD\u8981\u6C42\uFF0C\u4E0D\u662F\u7CBE\u5EA6\u53D6\u820D\u3002\n\nuniform int u_AtmosphereDenseFogEnabled;\n//\u6EE1\u5BC6\u5EA6\u533A\u7684\u6D88\u5149\u7CFB\u6570\uFF0C\u6BCF km\uFF0C\u7531 CPU \u6309 MOR \u4ECE\u80FD\u89C1\u5EA6\u6362\u7B97\nuniform float u_AtmosphereDenseFogExtinction;\n//\u6563\u5C04\u4EAE\u5EA6\uFF0C\u53D6\u73AF\u5883\u5149\u4E0E\u4E3B\u5149\u4E4B\u548C\nuniform vec4 u_AtmosphereDenseFogScattering;\n//(\u96FE\u9876\u9AD8\u5EA6 km, \u9884\u7559, \u9884\u7559, \u53C2\u8003\u7403\u534A\u5F84 km)\nuniform vec4 u_AtmosphereDenseFogProfile;\n//\u96FE\u9876\u8870\u51CF\u5C3A\u5EA6 km\uFF0C\u540D\u4E49\u9876\u90E8\u4FDD\u7559\u7A00\u8584\u5C3E\u90E8\nuniform float u_AtmosphereDenseFogTopFade;\n//\u5BC6\u5EA6\u6A21\u578B\uFF1A0 \u9AD8\u5EA6\u96FE\uFF08\u8BFB\u96FE\u9876\u4E0E\u8870\u51CF\u5C3A\u5EA6\uFF09\uFF0C1 \u8DDD\u79BB\u96FE\uFF08\u53EA\u7528\u8DDD\u79BB\uFF0C\u4E0A\u9762\u7684\u5256\u9762\u53C2\u6570\u4E0D\u53C2\u4E0E\uFF09\nuniform int u_AtmosphereDenseFogMode;\n\n//\u9AD8\u5EA6\u5256\u9762\uFF1A\u96FE\u5C42\u6CA1\u6709\u5E95\u9762\uFF0C\u96FE\u9876\u4EE5\u4E0B\u4E00\u76F4\u662F\u6EE1\u5BC6\u5EA6\uFF0C\u53EA\u5728\u96FE\u9876\u5E73\u6ED1\u964D\u81F3 5%\uFF0C\u518D\u5EF6\u4F38\u6307\u6570\u5C3E\u90E8\u3002\n//\u5C3E\u90E8\u4E3A 0.05 * (1 \u002B t) * exp(-t)\uFF0C\u4E0E\u5C42\u5185\u6E10\u53D8\u5728\u9876\u90E8\u5177\u6709\u76F8\u540C\u7684\u4E00\u9636\u5BFC\u6570\u3002\nfloat EvaluateFogProfile(float height, float top, float topFade)\n{\n    if (height \u003E top \u002B 24.0 * topFade) return 0.0;\n    if (topFade \u003C= 0.0 || height \u003C= top - topFade) return 1.0;\n\n    if (height \u003C= top)\n    {\n        float t = (height - (top - topFade)) / topFade;\n        return 1.0 - 0.95 * t * t * (3.0 - 2.0 * t);\n    }\n\n    float t = (height - top) / topFade;\n    return 0.05 * (1.0 \u002B t) * exp(-t);\n}\n\n//\u5256\u9762\u7684\u5168\u5C40\u539F\u51FD\u6570\uFF1A\u4ECE\u8D1F\u65E0\u7A77\u9AD8\u5EA6\u79EF\u5230 height \u7684\u5BC6\u5EA6\u7D2F\u8BA1\u91CF\u3002\n//\u5206\u6BB5\u79EF\u5206\u53D6\u8FDE\u7EED\u5E38\u6570\uFF0C\u5728 h = top-fade\u3001top\u3001top\u002B24*topFade \u4E09\u5904\u90FD\u4E0E\u4E0A\u4E00\u6BB5\u7B49\u503C\uFF0C\u51FD\u6570\u5168\u57DF\u8FDE\u7EED\uFF1A\n//   \u6052\u4E3A 1      \u222Bdh = h\n//   smoothstep  \u222B(1 - 0.95*t^2*(3 - 2t))dh = h - 0.95*fade*(t^3 - 0.5*t^4)\n//   \u6307\u6570\u5C3E\u90E8    \u222B0.05*(1 \u002B u)*exp(-u)dh = -0.05*fade*((u \u002B 2)*exp(-u))\nfloat EvaluateFogProfileIntegral(float height, float top, float topFade)\n{\n    //\u8870\u51CF\u5C3A\u5EA6\u4E3A\u96F6\u662F\u786C\u9876\uFF1A\u6EE1\u5BC6\u5EA6\u4E00\u76F4\u4FDD\u6301\u5230\u96FE\u9876\uFF0C\u539F\u51FD\u6570\u662F\u6298\u7EBF\n    if (topFade \u003C= 0.0) return min(height, top);\n\n    float base = top - topFade;\n    if (height \u003C= base) return height;\n\n    if (height \u003C= top)\n    {\n        float t = (height - base) / topFade;\n        return base \u002B topFade * (t - 0.95 * t * t * t \u002B 0.475 * t * t * t * t);\n    }\n\n    //\u96FE\u9876\u5904\u7684\u503C\uFF1Abase \u002B topFade * (1 - 0.95 \u002B 0.475) = top - 0.475 * topFade\n    float capped = min(height, top \u002B 24.0 * topFade);\n    float u = (capped - top) / topFade;\n    return (top - 0.475 * topFade) \u002B 0.05 * topFade * (2.0 - (u \u002B 2.0) * exp(-u));\n}\n\n//\u5C04\u7EBF\u5728\u6D53\u96FE\u91CC\u7684\u8DEF\u5F84\u957F\u5EA6\uFF0C\u5355\u4F4D km\u3002mu \u662F\u5C04\u7EBF\u65B9\u5411\u5728\u7AD6\u76F4\u65B9\u5411\u4E0A\u7684\u5206\u91CF\u3002\nfloat SampleDenseFogPathLength(float cameraHeight, float mu, float distance, float top, float topFade)\n{\n    //\u8DDD\u79BB\u96FE\uFF1A\u5BC6\u5EA6\u4E0E\u9AD8\u5EA6\u65E0\u5173\uFF0C\u8DEF\u5F84\u957F\u5EA6\u5C31\u662F\u8DDD\u79BB\u672C\u8EAB\u3002\n    //\u540C\u4E00\u5E27\u91CC\u753B\u9762\u5404\u5904\u7684\u6D53\u5EA6\u4E00\u6837\uFF0C\u6362\u4E0D\u6765\u0022\u8C37\u5730\u88AB\u57CB\u3001\u5C71\u810A\u9732\u51FA\u0022\uFF0C\u4F46\u4E5F\u4E0D\u9700\u8981\u4EFB\u4F55\u9AD8\u5EA6\u53C2\u6570\u3002\n    if (u_AtmosphereDenseFogMode == 1) return distance;\n\n    float ceiling = top \u002B 24.0 * topFade;\n\n    //\u6C34\u5E73\u5C04\u7EBF\uFF1A\u9AD8\u5EA6\u6CBF\u5C04\u7EBF\u4E0D\u53D8\uFF0C\u5BC6\u5EA6\u662F\u5E38\u91CF\u3002\u5FC5\u987B\u5148\u5224\u8FD9\u4E00\u652F\uFF0C\u5426\u5219\u4E0B\u9762\u7684\u539F\u51FD\u6570\u76F8\u51CF\u662F 0/0\n    if (abs(mu) * distance \u003C max(0.05 * topFade, 1e-6))\n    {\n        return cameraHeight \u003C= ceiling ? EvaluateFogProfile(cameraHeight, top, topFade) * dis\n... (truncated)"},{"Name":"passes","TypeName":"List\u003CShaderPass\u003E","Value":"1 elements\nDefault"},{"Name":"textureSlots","TypeName":"List\u003CShaderTextureSlot\u003E","Value":"0 elements"},{"Name":"colorSlots","TypeName":"List\u003CShaderColorSlot\u003E","Value":"0 elements"},{"Name":"floatSlots","TypeName":"List\u003CShaderFloatSlot\u003E","Value":"0 elements"}]}],"Messages":[],"IsStale":false,"IsLoading":false},"Runtime":null}