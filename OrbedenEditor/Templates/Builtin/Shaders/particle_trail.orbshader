--------queue Transparent

--------geometry Particle

--------vert
#version 430 core

layout(location = 0) in vec3 a_Position;
layout(location = 1) in vec3 a_Normal;
layout(location = 2) in vec2 a_TexCoord;
layout(location = 3) in vec3 a_Tangent;

uniform mat4 u_ViewProjection;
#include "Builtin/geometry_input.orbinc"

out vec2 v_TexCoord;
out vec4 v_Tint;
out vec3 v_WorldPosition;

void main()
{
    //拖尾的四边形 uv：(0,0) 起点左、(1,0) 起点右、(1,1) 终点右、(0,1) 终点左。
    //实例路径用 uv.y 选起终点、uv.x 选左右；展开路径在 CPU 已经写好同样的最终 UV。
    v_TexCoord = OrbedenGetUv(a_TexCoord);
    v_Tint = OrbedenGetTrailColor(a_TexCoord);
    v_WorldPosition = OrbedenGetTrailPosition(a_TexCoord);
    gl_Position = u_ViewProjection * vec4(v_WorldPosition, 1.0);
}

--------frag
#version 430 core

in vec2 v_TexCoord;
in vec4 v_Tint;
in vec3 v_WorldPosition;

uniform vec3 u_CameraPosition;
uniform bool u_HasDiffuseTexture;
uniform sampler2D u_DiffuseTexture;
uniform vec4 u_DiffuseColor;
uniform float u_Intensity;
uniform bool u_AtmosphereAdditive;
#include "Builtin/atmosphere_sampling.orbinc"

out vec4 FragColor;

void main()
{
    //两端颜色由顶点属性插值给出，Alpha 已经乘过沿寿命的淡出
    vec4 sampled = vec4(1.0);
    if (u_HasDiffuseTexture)
    {
        sampled = texture(u_DiffuseTexture, v_TexCoord);
    }

    vec3 color = sampled.rgb * max(u_DiffuseColor.rgb, vec3(0.0)) * v_Tint.rgb * max(u_Intensity, 0.0);
    float alpha = sampled.a * u_DiffuseColor.a * v_Tint.a;

    //加性混合只吃消光，叠上散射会整片发灰
    AtmosphereSample aerial = SampleSurfaceAerial(v_WorldPosition, GetAtmosphereScreenUv());
    AtmosphereSample fog = SampleSurfaceDenseFog(v_WorldPosition);
    //浓雾叠在空气透视外层：空气的散射也被浓雾吸收，浓雾的散射不再被空气吸收
    color *= aerial.transmittance * fog.transmittance;
    if (!u_AtmosphereAdditive) color += aerial.radiance * fog.transmittance + fog.radiance;

    FragColor = vec4(color, alpha);
}
