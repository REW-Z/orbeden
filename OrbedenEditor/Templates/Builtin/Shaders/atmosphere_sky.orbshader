--------queue Opaque

--------geometry Standard
--------expandedGeometry off

--------vert
#version 430 core

layout(location = 0) in vec3 a_Position;

out vec2 v_Uv;

void main()
{
    v_Uv = a_Position.xy * 0.5 + 0.5;
    gl_Position = vec4(a_Position.xy, 0.0, 1.0);
}

--------frag
#version 430 core

in vec2 v_Uv;

uniform mat4 u_AtmosphereInverseProjection;
uniform mat4 u_AtmosphereCameraWorldRotation;
uniform float u_AtmosphereCameraHeightKm;
uniform vec3 u_AtmosphereCameraUp;
uniform vec3 u_AtmosphereSunDirection;
uniform vec4 u_AtmosphereSunRadiance;
uniform vec4 u_AtmosphereGroundBackground;
uniform vec4 u_AtmosphereSkySize;
uniform int u_AtmosphereReflectionCapture;
uniform mat4 u_AtmosphereReflectionBasis;
uniform float u_AtmosphereReflectionHorizon;
uniform float u_AtmosphereReflectionTexelHeight;
uniform sampler2D u_AtmosphereSkyTexture;
uniform float u_AtmosphereAerosolDensity;
uniform vec4 u_AtmosphereAtlas;
uniform int u_AtmosphereStepCount;
#include "Builtin/atmosphere_common.orbinc"
#include "Builtin/dense_fog.orbinc"

out vec4 FragColor;

const int GroundSegmentSteps = 4;

//解析地球底板：覆盖率由视线与地平线的相对位置逐像素求出，
//透光率是地面到相机那一段自己的，不含地面之外的大气
void EvaluateGroundLayer(vec3 ray, bool sampleTransmittance, out float coverage, out vec3 transmittance)
{
    float h = max(u_AtmosphereCameraHeightKm, 0.0);
    float r = AtmosphereGroundRadius + h;
    float mu = dot(u_AtmosphereCameraUp, ray);

    //d > 0 表示视线落在地球上；以地平线为中心做一个像素宽的覆盖抗锯齿。
    //不能只向球内单边展开：那样恰好压在地平线上的那一像素拿不到底板，
    //而查找表在该行的值又是地平线上下的混合（近地暗、掠射亮），那一个像素就会压出一条暗线
    float muHorizon = -sqrt(max(h * (2.0 * AtmosphereGroundRadius + h), 0.0)) / r;
    float d = muHorizon - mu;
    float halfWidth = 0.5 * max(fwidth(d), 1.0e-7);
    coverage = smoothstep(-halfWidth, halfWidth, d);
    transmittance = vec3(1.0);

    //覆盖率恰好为零的像素（明显在地平线之上）不参与底板合成，透光率取什么值都无所谓
    if (coverage <= 0.0 || !sampleTransmittance) return;

    //抗锯齿带里落在地平线外侧的像素没有交点。底板那一侧的透光率必须取它在地平线上的极限：
    //直接拿 mu 查会提前返回、让 transmittance 停在初始的 1.0，合成时底板就按"无衰减"
    //整块叠上去——表现为沿弧线每隔几像素冒一个亮点（虚线），夜面反差最大时最明显。
    //把方向夹到地平线以内再求交，拿到的就是掠过地平线那条的透光率
    float groundMu = min(mu, muHorizon - 1.0e-6);
    float groundDistance = IntersectGroundDistance(h, groundMu);
    if (groundDistance < 0.0) return;

    //相机在大气外：地面到相机之间是整层大气，沿视线一次查表足够
    if (h >= AtmosphereTopHeight)
    {
        vec3 groundUp = normalize(r * u_AtmosphereCameraUp + groundDistance * ray);
        transmittance = exp(-SampleSunOpticalDepth(0.0, dot(groundUp, -ray)));
        return;
    }

    //相机在大气内：地面到相机是一段近距离，直接在射线上积分，不走透射率表。
    //表在近地平线方向给不出这一段：两端的 tau 都很大（掠射气柱红约 24、蓝可到几百），
    //要的是它们之间不到 1 的差，而半精度表在 tau≈287 处的 ulp 就有 0.25，
    //相减只会得到零或噪声——表现为贴着地平线的一条亮线，转向时随雾与太阳方位闪动
    vec3 tau = vec3(0.0);
    float step = groundDistance / float(GroundSegmentSteps);
    for (int index = 0; index < GroundSegmentSteps; ++index)
    {
        float distance = (float(index) + 0.5) * step;
        vec3 scatteringRayleigh = vec3(0.0);
        vec3 scatteringMie = vec3(0.0);
        vec3 extinction = vec3(0.0);
        EvaluateScattering(ComputeAltitude(h, groundMu, distance), u_AtmosphereAerosolDensity,
            scatteringRayleigh, scatteringMie, extinction);
        tau += extinction * step;
    }

    transmittance = exp(-tau);
}

void main()
{
    //按屏幕像素或经纬贴图坐标还原视线
    bool reflectionCapture = u_AtmosphereReflectionCapture != 0;
    vec3 viewRay;
    if (reflectionCapture)
    {
        float azimuth = (v_Uv.x * 2.0 - 1.0) * AtmospherePi;
        float latitude = v_Uv.y;
        //在第一个完整的天空纹素记录地平线方向
        float firstSkyRow = ceil(u_AtmosphereReflectionHorizon / u_AtmosphereReflectionTexelHeight);
        float firstSkyCenter = (firstSkyRow + 0.5) * u_AtmosphereReflectionTexelHeight;
        if (latitude >= firstSkyRow * u_AtmosphereReflectionTexelHeight)
        {
            float horizonWeight = 1.0 - smoothstep(firstSkyCenter,
                firstSkyCenter + 2.0 * u_AtmosphereReflectionTexelHeight, latitude);
            latitude = max(u_AtmosphereReflectionHorizon,
                latitude - (firstSkyCenter - u_AtmosphereReflectionHorizon) * horizonWeight);
        }
        float elevation = (latitude - 0.5) * AtmospherePi;
        float horizontal = cos(elevation);
        vec3 direction = vec3(horizontal * cos(azimuth), sin(elevation), horizontal * sin(azimuth));
        viewRay = normalize(mat3(u_AtmosphereReflectionBasis) * direction);
    }
    else
    {
        vec4 viewPosition = u_AtmosphereInverseProjection * vec4(v_Uv * 2.0 - 1.0, 1.0, 1.0);
        viewRay = normalize((u_AtmosphereCameraWorldRotation * viewPosition).xyz);
    }
    float muSun = dot(viewRay, u_AtmosphereSunDirection);
    float mu = dot(u_AtmosphereCameraUp, viewRay);

    //按高度与地平线邻域选择天空积分路径
    float height = max(u_AtmosphereCameraHeightKm, 0.0);
    float horizon = -sqrt(height * (2.0 * AtmosphereGroundRadius + height)) / (AtmosphereGroundRadius + height);
    vec2 nodeAngle = 2.0 * vec2(abs(u_AtmosphereInverseProjection[0][0]), abs(u_AtmosphereInverseProjection[1][1]))
        / (u_AtmosphereAtlas.xy - 1.0);
    float band = max(nodeAngle.x, nodeAngle.y);
    float angleBelowHorizon = asin(horizon) - asin(clamp(mu, -1.0, 1.0));
    //按屏幕或反射贴图的角分辨率选择地平线积分带
    float angleFromHorizon = abs(angleBelowHorizon);
    float traceWeight;
    if (reflectionCapture)
    {
        float rowAngle = AtmospherePi * u_AtmosphereReflectionTexelHeight;
        traceWeight = 1.0 - smoothstep(rowAngle, 2.0 * rowAngle, angleFromHorizon);
    }
    else
    {
        traceWeight = max(smoothstep(8.0, 16.0, height),
            1.0 - smoothstep(band, 2.0 * band, angleFromHorizon));
    }

    //将地平线下方一度内的背景从掠射天空色渐变到地表色
    float groundBlend = smoothstep(0.0, radians(1.0), angleBelowHorizon);

    //逐像素计算地球轮廓覆盖率
    float groundCoverage;
    vec3 groundTransmittance;
    EvaluateGroundLayer(viewRay, traceWeight < 1.0, groundCoverage, groundTransmittance);
    vec3 color = vec3(0.0);
    if (traceWeight < 1.0)
    {
        //按太阳相对方位角查询近地天空
        float sunZenith = dot(u_AtmosphereCameraUp, u_AtmosphereSunDirection);
        float viewHorizontal = sqrt(max(1.0 - mu * mu, 0.0));
        float sunHorizontal = sqrt(max(1.0 - sunZenith * sunZenith, 0.0));
        float cosine = viewHorizontal * sunHorizontal > 1.0e-6
            ? clamp((muSun - mu * sunZenith) / (viewHorizontal * sunHorizontal), -1.0, 1.0) : 1.0;
        float skyU = sqrt(clamp((1.0 - cosine) * 0.5, 0.0, 1.0));
        float skyV = AtmosphereSkyUvFromZenithCos(mu, u_AtmosphereCameraHeightKm);
        vec2 lookupUv = (vec2(0.5) + vec2(skyU, skyV) * (u_AtmosphereSkySize.xy - 1.0)) / u_AtmosphereSkySize.xy;
        float rowStep = 0.5 / u_AtmosphereSkySize.y;
        vec3 skyBelow = textureLod(u_AtmosphereSkyTexture, vec2(lookupUv.x, min(lookupUv.y, 0.5 - rowStep)), 0.0).rgb;
        vec3 skyAbove = textureLod(u_AtmosphereSkyTexture, vec2(lookupUv.x, max(lookupUv.y, 0.5 + rowStep)), 0.0).rgb;
        color = mix(skyAbove, skyBelow + groundTransmittance * u_AtmosphereGroundBackground.rgb, groundBlend);
    }

    //沿真实像素视线积分并覆盖轮廓的两侧
    if (traceWeight > 0.0)
    {
        vec3 tracedColor = vec3(0.0);
        vec3 tangent = viewRay - mu * u_AtmosphereCameraUp;
        float tangentLength = length(tangent);
        if (tangentLength > 0.0)
        {
            tangent /= tangentLength;
        }
        if (groundBlend > 0.0)
        {
            float groundMu = min(mu, horizon - 1.0e-6);
            vec3 groundRay = groundMu == mu ? viewRay
                : groundMu * u_AtmosphereCameraUp + sqrt(max(1.0 - groundMu * groundMu, 0.0)) * tangent;
            vec3 radiance;
            vec3 tau;
            IntegrateAtmosphere(u_AtmosphereCameraHeightKm, u_AtmosphereCameraUp, groundRay, 1000000.0,
                u_AtmosphereStepCount, 0, u_AtmosphereAerosolDensity,
                u_AtmosphereSunRadiance.rgb, u_AtmosphereSunDirection, radiance, tau);
            tracedColor += groundBlend * (radiance + exp(-tau) * u_AtmosphereGroundBackground.rgb);
        }
        if (groundBlend < 1.0)
        {
            float skyMu = max(mu, horizon + 1.0e-6);
            vec3 skyRay = skyMu == mu ? viewRay
                : skyMu * u_AtmosphereCameraUp + sqrt(max(1.0 - skyMu * skyMu, 0.0)) * tangent;
            vec3 radiance;
            vec3 tau;
            IntegrateAtmosphere(u_AtmosphereCameraHeightKm, u_AtmosphereCameraUp, skyRay, 1000000.0,
                u_AtmosphereStepCount, 0, u_AtmosphereAerosolDensity,
                u_AtmosphereSunRadiance.rgb, u_AtmosphereSunDirection, radiance, tau);
            tracedColor += (1.0 - groundBlend) * radiance;
        }
        color = mix(color, tracedColor, traceWeight);
    }

    //绘制背景中的太阳盘，反射中的太阳高光由材质的主光计算
    if (!reflectionCapture)
    {
        float cosRadius = cos(AtmosphereSunAngularRadius);
        float sunCoverage = smoothstep(cosRadius - max(fwidth(muSun), 1.0e-7), cosRadius, muSun);
        float solidAngle = AtmospherePi * sin(AtmosphereSunAngularRadius) * sin(AtmosphereSunAngularRadius);
        vec3 sunTransmittance = SampleSunDiskTransmittance(u_AtmosphereCameraHeightKm, mu);
        color += u_AtmosphereSunRadiance.rgb * sunTransmittance * sunCoverage * (1.0 - groundCoverage) / solidAngle;
    }

    //浓雾遮蔽天空，视线取天空方向，整幅天空只算一次
    vec3 fogTransmittance = vec3(1.0);
    vec3 fogRadiance = vec3(0.0);
    SampleDenseFog(u_AtmosphereCameraHeightKm, u_AtmosphereCameraUp, viewRay, 1000000.0,
        fogTransmittance, fogRadiance);

    //浓雾叠在空气散射外层，顺序与物体表面一致
    if (fogTransmittance.x < 1.0)
        color = color * fogTransmittance + fogRadiance;
    FragColor = vec4(color, 1.0);
}
