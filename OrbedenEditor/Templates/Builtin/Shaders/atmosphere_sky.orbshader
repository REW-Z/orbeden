--------queue Opaque

--------geometry Standard
--------expandedGeometry off

--------vert
#version 430 core

layout(location = 0) in vec3 a_Position;

out vec2 v_Uv;

void main()
{
    v_Uv = a_Position.xy * 0.5 + 0.5;
    gl_Position = vec4(a_Position.xy, 0.0, 1.0);
}

--------frag
#version 430 core

in vec2 v_Uv;

uniform mat4 u_AtmosphereInverseProjection;
uniform mat4 u_AtmosphereCameraWorldRotation;
uniform float u_AtmosphereCameraHeightKm;
uniform vec3 u_AtmosphereCameraUp;
uniform vec3 u_AtmosphereSunDirection;
uniform vec4 u_AtmosphereSunRadiance;
uniform vec4 u_AtmosphereGroundBackground;
uniform vec4 u_AtmosphereSkySize;
uniform sampler2D u_AtmosphereSkyTexture;
uniform int u_AtmosphereFogDebugView;
uniform float u_AtmosphereAerosolDensity;
uniform int u_AtmosphereStepCount;
#include "Builtin/atmosphere_common.orbinc"
#include "Builtin/dense_fog.orbinc"

out vec4 FragColor;

//联合积分重叠区空气与浓雾，保留完整天空中区间外的贡献
vec3 IntegrateSkyFog(vec3 color, vec3 ray, vec3 frontRadiance, vec3 frontTau)
{
    float groundRadius = u_AtmosphereDenseFogProfile.w;
    float cameraHeight = u_AtmosphereCameraHeightKm;
    float mu = dot(u_AtmosphereCameraUp, ray);
    float top = max(u_AtmosphereDenseFogProfile.x, -groundRadius);
    float topFade = clamp(u_AtmosphereDenseFogTopFade, 0.0, max(top, 0.0));
    float start = 0.0;
    float end = 0.0;
    float secondStart = 0.0;
    float secondEnd = 0.0;
    if (ComputeShellIntervals(cameraHeight, mu, -groundRadius,
        max(top + 24.0 * topFade, -groundRadius), groundRadius, 1000000.0,
        start, end, secondStart, secondEnd) == 0) return color;

    //空气区间与浓雾区间裁到同一段
    float airStart = 0.0;
    float airEnd = 0.0;
    ClipAtmosphereSegment(cameraHeight, mu, end, airStart, airEnd);
    vec2 phase = EvaluatePhase(dot(ray, u_AtmosphereSunDirection));
    vec3 airTransmittance = exp(-frontTau);
    vec3 mixedTransmittance = airTransmittance;
    vec3 airRadiance = vec3(0.0);
    vec3 mixedRadiance = vec3(0.0);
    float fogTransmittance = 1.0;
    int steps = clamp(u_AtmosphereStepCount, 32, AtmosphereMaxSteps);
    float ds = (end - start) / float(steps);
    for (int index = 0; index < AtmosphereMaxSteps; ++index)
    {
        if (index >= steps) break;
        float distance = start + (float(index) + 0.5) * ds;
        float height = ComputeFogHeight(cameraHeight, mu, distance, groundRadius);
        float fogExtinction = u_AtmosphereDenseFogExtinction * EvaluateFogProfile(height, top, topFade);
        vec3 airExtinction = vec3(0.0);
        vec3 airSource = vec3(0.0);
        if (distance >= airStart && distance < airEnd)
        {
            vec3 rayleigh = vec3(0.0);
            vec3 mie = vec3(0.0);
            EvaluateScattering(height, u_AtmosphereAerosolDensity, rayleigh, mie, airExtinction);
            vec3 localUp = normalize((groundRadius + cameraHeight) * u_AtmosphereCameraUp + distance * ray);
            vec3 sunlight = u_AtmosphereSunRadiance.rgb * SampleSunTransmittance(height, dot(localUp, u_AtmosphereSunDirection));
            airSource = sunlight * (rayleigh * phase.x + mie * phase.y);
        }

        //累计同一步的空气与混合介质散射
        vec3 mixedExtinction = airExtinction + vec3(fogExtinction);
        vec3 airAttenuation = exp(-airExtinction * ds);
        vec3 mixedAttenuation = exp(-mixedExtinction * ds);
        vec3 airWeight = mix(vec3(ds), (vec3(1.0) - airAttenuation) / max(airExtinction, vec3(1.0e-6)), step(vec3(1.0e-6), airExtinction));
        vec3 mixedWeight = mix(vec3(ds), (vec3(1.0) - mixedAttenuation) / max(mixedExtinction, vec3(1.0e-6)), step(vec3(1.0e-6), mixedExtinction));
        airRadiance += airTransmittance * airSource * airWeight;
        mixedRadiance += mixedTransmittance * (airSource + fogExtinction * u_AtmosphereDenseFogScattering.rgb) * mixedWeight;
        airTransmittance *= airAttenuation;
        mixedTransmittance *= mixedAttenuation;
        fogTransmittance *= exp(-fogExtinction * ds);
    }

    //用混合散射替换天空中原有的重叠区空气散射
    return max(color * fogTransmittance + frontRadiance * (1.0 - fogTransmittance)
        + mixedRadiance - fogTransmittance * airRadiance, vec3(0.0));
}

//地面段透光率的积分步数。这一段只会随"透光率还有意义"的短距离出现，
//段一长 tau 就远大于 1、结果必然是零，所以定点几步就够
const int GroundSegmentSteps = 4;

//解析地球底板：覆盖率由视线与地平线的相对位置逐像素求出，
//透光率是地面到相机那一段自己的，不含地面之外的大气
void EvaluateGroundLayer(vec3 ray, out float coverage, out vec3 transmittance)
{
    float h = max(u_AtmosphereCameraHeightKm, 0.0);
    float r = AtmosphereGroundRadius + h;
    float mu = dot(u_AtmosphereCameraUp, ray);

    //d > 0 表示视线落在地球上；以地平线为中心做一个像素宽的覆盖抗锯齿。
    //不能只向球内单边展开：那样恰好压在地平线上的那一像素拿不到底板，
    //而查找表在该行的值又是地平线上下的混合（近地暗、掠射亮），那一个像素就会压出一条暗线
    float muHorizon = -sqrt(max(h * (2.0 * AtmosphereGroundRadius + h), 0.0)) / r;
    float d = muHorizon - mu;
    float halfWidth = 0.5 * max(fwidth(d), 1.0e-7);
    coverage = smoothstep(-halfWidth, halfWidth, d);
    transmittance = vec3(1.0);

    //覆盖率恰好为零的像素（明显在地平线之上）不参与底板合成，透光率取什么值都无所谓
    if (coverage <= 0.0) return;

    //抗锯齿带里落在地平线外侧的像素没有交点。底板那一侧的透光率必须取它在地平线上的极限：
    //直接拿 mu 查会提前返回、让 transmittance 停在初始的 1.0，合成时底板就按"无衰减"
    //整块叠上去——表现为沿弧线每隔几像素冒一个亮点（虚线），夜面反差最大时最明显。
    //把方向夹到地平线以内再求交，拿到的就是掠过地平线那条的透光率
    float groundMu = min(mu, muHorizon - 1.0e-6);
    float groundDistance = IntersectGroundDistance(h, groundMu);
    if (groundDistance < 0.0) return;

    //相机在大气外：地面到相机之间是整层大气，沿视线一次查表足够
    if (h >= AtmosphereTopHeight)
    {
        vec3 groundUp = normalize(r * u_AtmosphereCameraUp + groundDistance * ray);
        transmittance = exp(-SampleSunOpticalDepth(0.0, dot(groundUp, -ray)));
        return;
    }

    //相机在大气内：地面到相机是一段近距离，直接在射线上积分，不走透射率表。
    //表在近地平线方向给不出这一段：两端的 tau 都很大（掠射气柱红约 24、蓝可到几百），
    //要的是它们之间不到 1 的差，而半精度表在 tau≈287 处的 ulp 就有 0.25，
    //相减只会得到零或噪声——表现为贴着地平线的一条亮线，转向时随雾与太阳方位闪动
    vec3 tau = vec3(0.0);
    float step = groundDistance / float(GroundSegmentSteps);
    for (int index = 0; index < GroundSegmentSteps; ++index)
    {
        float distance = (float(index) + 0.5) * step;
        vec3 scatteringRayleigh = vec3(0.0);
        vec3 scatteringMie = vec3(0.0);
        vec3 extinction = vec3(0.0);
        EvaluateScattering(ComputeAltitude(h, groundMu, distance), u_AtmosphereAerosolDensity,
            scatteringRayleigh, scatteringMie, extinction);
        tau += extinction * step;
    }

    transmittance = exp(-tau);
}

void main()
{
    //当前像素的重建方向
    vec4 viewPosition = u_AtmosphereInverseProjection * vec4(v_Uv * 2.0 - 1.0, 1.0, 1.0);
    vec3 viewRay = normalize((u_AtmosphereCameraWorldRotation * viewPosition).xyz);
    float muSun = dot(viewRay, u_AtmosphereSunDirection);
    float mu = dot(u_AtmosphereCameraUp, viewRay);

    //按方向查询天空查找表：列是视线与太阳方向的夹角余弦，行是地平线相对仰角。
    //地平线两侧的值分开取，不让表自己跨边界混合：以上是太空（掠射、亮），
    //以下是最多几公里的近地散射（很暗，相机低于海平面时恰好为零）。
    //混合出来的值哪一侧都不代表，贴着地平线的那一像素就会因此变暗——
    //相机低于海平面时下面那行是 0，偏差最大；转动视角时偏差还随雾和太阳方位变化，
    //看起来就是那条线在亮暗之间闪。这里把两个采样坐标夹到地平线的两侧行，
    //再由地面覆盖率在"地面（含底板）"与"天空"之间混合
    float skyV = AtmosphereSkyUvFromZenithCos(mu, u_AtmosphereCameraHeightKm);
    float rowStep = 0.5 / max(u_AtmosphereSkySize.y, 1.0);
    float skyU = muSun * 0.5 + 0.5;
    vec3 skyBelow = texture(u_AtmosphereSkyTexture, vec2(skyU, min(skyV, 0.5 - rowStep))).rgb;
    vec3 skyAbove = texture(u_AtmosphereSkyTexture, vec2(skyU, max(skyV, 0.5 + rowStep))).rgb;

    //地球底板按像素解析合成：逐像素判交，边界与查找表分辨率无关
    float groundCoverage = 0.0;
    vec3 groundTransmittance = vec3(1.0);
    EvaluateGroundLayer(viewRay, groundCoverage, groundTransmittance);
    vec3 groundColor = skyBelow + groundTransmittance * u_AtmosphereGroundBackground.rgb;
    vec3 color = mix(groundColor, skyAbove, 1.0 - groundCoverage);

    //太阳盘边缘按像素覆盖宽度抗锯齿，落到地球上的部分按地面覆盖率淡出
    float cosRadius = cos(AtmosphereSunAngularRadius);
    float sunCoverage = smoothstep(cosRadius - max(fwidth(muSun), 1.0e-7), cosRadius, muSun);
    float solidAngle = AtmospherePi * sin(AtmosphereSunAngularRadius) * sin(AtmosphereSunAngularRadius);
    vec3 sunTransmittance = SampleSunTransmittance(u_AtmosphereCameraHeightKm,
        dot(u_AtmosphereCameraUp, u_AtmosphereSunDirection));
    color += u_AtmosphereSunRadiance.rgb * sunTransmittance * sunCoverage * (1.0 - groundCoverage) / solidAngle;

    //调试视图直接替换天空颜色
    if (u_AtmosphereFogDebugView > 0 && u_AtmosphereFogDebugView != 7)
    {
        FragColor = vec4(GetDenseFogDebugColor(u_AtmosphereCameraHeightKm, u_AtmosphereCameraUp, viewRay,
            1000000.0, u_AtmosphereFogDebugView), 1.0);
        return;
    }

    //浓雾遮蔽天空，与物体共用同一套区间与剖面计算，整幅天空只算一次
    vec3 fogTransmittance = vec3(1.0);
    vec3 fogRadiance = vec3(0.0);
    float fogEntryKm = -1.0;
    SampleDenseFog(u_AtmosphereCameraHeightKm, u_AtmosphereCameraUp, viewRay, 1000000.0,
        fogTransmittance, fogRadiance, fogEntryKm);

    //积分相机到浓雾入口之间的空气
    vec3 frontRadiance = vec3(0.0);
    vec3 frontTau = vec3(0.0);
    if (fogEntryKm > 0.0)
    {
        IntegrateAtmosphere(u_AtmosphereCameraHeightKm, u_AtmosphereCameraUp, viewRay, fogEntryKm,
            u_AtmosphereStepCount, 0, u_AtmosphereAerosolDensity,
            u_AtmosphereSunRadiance.rgb, u_AtmosphereSunDirection, frontRadiance, frontTau);
    }

    if (u_AtmosphereFogDebugView == 7)
    {
        FragColor = vec4(clamp(frontRadiance, 0.0, 1.0), 1.0);
        return;
    }

    //联合计算重叠区，关闭或未命中浓雾时保留天空
    if (fogTransmittance.x < 1.0)
        color = IntegrateSkyFog(color, viewRay, frontRadiance, frontTau);
    FragColor = vec4(color, 1.0);
}
