--------queue Opaque

--------geometry Standard

--------vert
#version 430 core

layout(location = 0) in vec3 a_Position;
layout(location = 1) in vec3 a_Normal;
layout(location = 2) in vec2 a_TexCoord;
layout(location = 3) in vec3 a_Tangent;

uniform mat4 u_ViewProjection;
#include "Builtin/geometry_input.orbinc"

out vec3 v_WorldPosition;
out vec3 v_Normal;
out vec2 v_TexCoord;
out vec4 v_Tint;

void main()
{
    mat4 model = OrbedenGetModel();
    vec4 worldPosition = model * vec4(a_Position, 1.0);
    v_WorldPosition = worldPosition.xyz;
    //法线沿用模型矩阵本身，与旧公式一致，不顺带改变已调好的光照
    v_Normal = mat3(model) * a_Normal;
    v_TexCoord = OrbedenGetUv(a_TexCoord);
    v_Tint = OrbedenGetTint();
    gl_Position = u_ViewProjection * worldPosition;
}

--------frag
#version 430 core

in vec3 v_WorldPosition;
in vec3 v_Normal;
in vec2 v_TexCoord;
in vec4 v_Tint;

uniform vec3 u_CameraPosition;
uniform vec4 u_AmbientColor;
uniform vec4 u_DiffuseColor;
uniform vec4 u_SpecularColor;
uniform float u_Shininess;
uniform vec3 u_LightDirection;
uniform vec4 u_LightColor;
uniform float u_LightIntensity;
uniform bool u_HasDiffuseTexture;
uniform sampler2D u_DiffuseTexture;
#include "Builtin/shadow_common.orbinc"
#include "Builtin/environment_reflection.orbinc"
#include "Builtin/atmosphere_sampling.orbinc"

out vec4 FragColor;

void main()
{
    //着色器工作在线性空间：采样已由 sRGB 纹理格式解码，材质颜色已由绑定层转成线性。
    vec3 albedo = max(u_DiffuseColor.rgb, vec3(0.0));
    if (u_HasDiffuseTexture)
    {
        albedo *= texture(u_DiffuseTexture, v_TexCoord).rgb;
    }

    vec3 normal = normalize(v_Normal);
    vec3 lightDir = normalize(-u_LightDirection);
    vec3 viewDir = normalize(u_CameraPosition - v_WorldPosition);
    vec3 halfDir = normalize(lightDir + viewDir);

    float nDotL = max(dot(normal, lightDir), 0.0);
    float nDotH = max(dot(normal, halfDir), 0.0);
    float vDotH = max(dot(viewDir, halfDir), 0.0);
    float shadow = SampleShadow(v_WorldPosition, normal);

    //u_SpecularColor 直接作为垂直入射反射率，黑色即无高光，与旧行为一致
    vec3 fresnel = u_SpecularColor.rgb + (1.0 - u_SpecularColor.rgb) * pow(1.0 - vDotH, 5.0);

    //归一化 Blinn-Phong 镜面，并约去美术强度对应的 Pi
    float specularPower = max(u_Shininess, 1.0);
    float specularNorm = (specularPower + 8.0) / 8.0;
    vec3 specular = fresnel * pow(nDotH, specularPower) * specularNorm;

    //按美术强度使用单位漫反射响应，并扣除菲涅耳分配给镜面的能量
    vec3 diffuse = albedo * (1.0 - fresnel);

    vec3 ambient = u_AmbientColor.rgb * albedo;
    vec3 direct = (diffuse + specular) * nDotL * u_LightColor.rgb * max(u_LightIntensity, 0.0);
    float roughness = pow(2.0 / (specularPower + 2.0), 0.25);
    vec3 reflection = EvaluateEnvironmentReflection(normal, viewDir, u_SpecularColor.rgb, roughness, 1.0);
    vec3 color = ambient + direct * (1.0 - shadow) + reflection;
    //每实例 tint 默认白色，不改变原有画面
    color *= v_Tint.rgb;
    //光照与 tint 完成后依次合成空气透视与浓雾
    color = ApplySurfaceFog(color, v_WorldPosition, GetAtmosphereScreenUv());
    //输出线性值，显示转换统一在输出 Pass 完成
    FragColor = vec4(color, v_Tint.a);
}
