uniform samplerCube u_EnvironmentTexture;
uniform sampler2D u_AtmosphereReflectionTexture;
uniform mat4 u_AtmosphereReflectionBasis;
uniform float u_AtmosphereReflectionHorizon;
uniform int u_UseAtmosphereReflection;
uniform float u_EnvironmentIntensity;
uniform float u_EnvironmentMaxLod;

//按经纬方向与粗糙度采样已滤波的 HDR 反射贴图
vec3 SampleAtmosphereReflection(vec3 direction, float roughness, bool skyOnly)
{
    const float pi = 3.141592653589793;
    vec3 localDirection = direction * mat3(u_AtmosphereReflectionBasis);
    float azimuth = dot(localDirection.xz, localDirection.xz) > 1.0e-8 ? atan(localDirection.z, localDirection.x) : 0.0;
    float elevation = asin(clamp(localDirection.y, -1.0, 1.0));
    vec2 uv = vec2(azimuth / (2.0 * pi), elevation / pi) + 0.5;
    float height = float(textureSize(u_AtmosphereReflectionTexture, 0).y);
    float lod = roughness * log2(height);
    if (skyOnly)
    {
        //为三线性滤波的较粗级别预留最多三个基级缩放后的纹素
        float rowsAboveHorizon = (uv.y - u_AtmosphereReflectionHorizon) * height;
        float skyLod = log2(max(rowsAboveHorizon / 3.0, 1.0));
        lod = min(lod, skyLod);

        //将双线性采样压到第一行完整的天空纹素中心
        float firstSkyRow = ceil(u_AtmosphereReflectionHorizon * height);
        uv.y = max(uv.y, (firstSkyRow + 0.5) / height);
    }
    float polarMargin = 0.5 * exp2(ceil(lod)) / height;
    uv.y = clamp(uv.y, polarMargin, 1.0 - polarMargin);
    return textureLod(u_AtmosphereReflectionTexture, uv, lod).rgb;
}

//按粗糙度采样全局环境辐亮度
vec3 SampleEnvironmentRadiance(vec3 direction, float roughness, bool skyOnly)
{
    return u_UseAtmosphereReflection != 0
        ? SampleAtmosphereReflection(direction, roughness, skyOnly)
        : textureLod(u_EnvironmentTexture, direction, roughness * u_EnvironmentMaxLod).rgb;
}

//采样通用材质的完整环境
vec3 SampleEnvironmentRadiance(vec3 direction, float roughness)
{
    return SampleEnvironmentRadiance(direction, roughness, false);
}

//按表面反射率与遮蔽计算环境镜面反射
vec3 EvaluateEnvironmentReflection(vec3 normal, vec3 viewDir, vec3 f0, float roughness, float occlusion)
{
    if (u_EnvironmentIntensity <= 0.0) return vec3(0.0);
    float nDotV = clamp(dot(normal, viewDir), 0.0, 1.0);
    roughness = clamp(roughness, 0.0, 1.0);
    f0 = clamp(f0, vec3(0.0), vec3(1.0));
    vec3 fresnel = f0 + (max(vec3(1.0 - roughness), f0) - f0) * pow(1.0 - nDotV, 5.0);
    vec3 direction = reflect(-viewDir, normal);
    return SampleEnvironmentRadiance(direction, roughness) * fresnel * u_EnvironmentIntensity * clamp(occlusion, 0.0, 1.0);
}
