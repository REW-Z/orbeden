uniform samplerCube u_EnvironmentTexture;
uniform float u_EnvironmentIntensity;
uniform float u_EnvironmentMaxLod;

//采样全局环境镜面反射，按粗糙度选择近似模糊层级
vec3 EvaluateEnvironmentReflection(vec3 normal, vec3 viewDir, vec3 f0, float roughness, float occlusion)
{
    if (u_EnvironmentIntensity <= 0.0) return vec3(0.0);
    float nDotV = clamp(dot(normal, viewDir), 0.0, 1.0);
    roughness = clamp(roughness, 0.0, 1.0);
    f0 = clamp(f0, vec3(0.0), vec3(1.0));
    vec3 fresnel = f0 + (max(vec3(1.0 - roughness), f0) - f0) * pow(1.0 - nDotV, 5.0);
    vec3 direction = reflect(-viewDir, normal);
    vec3 environment = textureLod(u_EnvironmentTexture, direction, roughness * u_EnvironmentMaxLod).rgb;
    return environment * fresnel * u_EnvironmentIntensity * clamp(occlusion, 0.0, 1.0);
}
