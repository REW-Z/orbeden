<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>$(GameAssemblyName).Editor</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);ORBEDEN_EDITOR</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="$(GameBindingNamespace)" Alias="Native" Condition="'$(GameBindingNamespace)' != ''" />
    <Compile Include="$(GameContentRoot)/**/Editor/**/*.cs" />
    <Reference Include="$(GameAssemblyName)"><HintPath>$(GameAssemblyPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="OrbedenCore.CSharp"><HintPath>$(GameRuntimeAssembly)</HintPath><Private>false</Private></Reference>
    <Reference Include="Orbeden.Editor"><HintPath>$(GameEditorAssembly)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
