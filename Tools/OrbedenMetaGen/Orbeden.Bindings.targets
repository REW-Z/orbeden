<Project>
  <!--
    游戏 C# 工程的绑定生成目标。由 Orbeden SDK 发布到 Sdk/Tools/OrbedenMetaGen/，
    再经游戏工程的 Lib/Orbeden.Bindings.targets 转发进来。
    这里是唯一来源：引擎侧改动随 SDK 一起刷新，项目内不再保留副本。

    $(OrbedenSdkRoot) 由转发文件或调用方（Editor 的 dotnet build）提供。
    工程文件直接放在项目根，因此 MSBuildProjectDirectory 就是项目根。
  -->
  <PropertyGroup>
    <OrbedenProjectRoot Condition="'$(OrbedenProjectRoot)' == ''">$(MSBuildProjectDirectory)</OrbedenProjectRoot>
    <!--内容根：美术、音频、场景与代码脚本，内部结构完全自由。-->
    <OrbedenContentRoot>$(OrbedenProjectRoot)/Content</OrbedenContentRoot>
    <!--MetaGen 扫描内容根，生成物落在内容根之外的原生构建目录。-->
    <OrbedenNativeSource>$(OrbedenContentRoot)</OrbedenNativeSource>
    <OrbedenBindingOutput>$(OrbedenProjectRoot)/Build/Native/Generated</OrbedenBindingOutput>
    <OrbedenBindingNamespace>$(RootNamespace).Native</OrbedenBindingNamespace>
    <!--用户手册随 SDK 刷新，落点与 Lib 下其他 SDK 快照同级。-->
    <OrbedenManualSource>$(OrbedenSdkRoot)/Manual</OrbedenManualSource>
    <OrbedenManualTarget>$(OrbedenProjectRoot)/Lib/Docs</OrbedenManualTarget>
  </PropertyGroup>
  <!--
    Orbeden.UI 包：整包只有一个来源。项目内 Packages/Orbeden.UI/ 存在时整体覆盖 SDK 来源，
    否则用 SDK 的 Packages/Orbeden.UI/。OrbedenUIPackageRoot 只会指向其中一个，
    因此两份包不可能同时进入 Compile；加载顺序上 SDK 包先算，项目覆盖包把它整体顶掉。
  -->
  <PropertyGroup>
    <OrbedenUIProjectPackageRoot>$(OrbedenProjectRoot)/Packages/Orbeden.UI</OrbedenUIProjectPackageRoot>
    <OrbedenUISdkPackageRoot>$(OrbedenSdkRoot)/Packages/Orbeden.UI</OrbedenUISdkPackageRoot>
    <OrbedenUIPackageRoot Condition="Exists('$(OrbedenUIProjectPackageRoot)/Orbeden.UI.targets')">$(OrbedenUIProjectPackageRoot)</OrbedenUIPackageRoot>
    <OrbedenUIPackageRoot Condition="'$(OrbedenUIPackageRoot)' == '' and Exists('$(OrbedenUISdkPackageRoot)/Orbeden.UI.targets')">$(OrbedenUISdkPackageRoot)</OrbedenUIPackageRoot>
    <!--引擎当前提供的 RetainedGuiApi 主版本；包声明的所需主版本必须与它相等。-->
    <OrbedenRetainedGuiApiMajor>2</OrbedenRetainedGuiApiMajor>
  </PropertyGroup>
  <!--
    是否包含原生模块，与上面的源根无关：源根是内容根，工程文件则在项目根，不能跟着源根一起改。
  -->
  <ItemGroup>
    <NativeVcxProject Include="$(OrbedenProjectRoot)/*.vcxproj" />
  </ItemGroup>
  <!--
    脚本编译项：内容根下的 .cs 自动进入游戏程序集，Editor 文件夹单独编译为编辑器扩展。
    基础属性里的 EnableDefaultCompileItems=false 已关掉 SDK 的默认通配，这里就是全部来源。
    内容根之外按定义不含用户脚本。
  -->
  <ItemGroup>
    <Compile Include="$(OrbedenContentRoot)/**/*.cs" Exclude="$(OrbedenContentRoot)/**/Editor/**/*.cs" />
    <OrbedenEditorSource Include="$(OrbedenContentRoot)/**/Editor/**/*.cs" />
    <!--
      NativeAOT 要求导出层编译进游戏程序集本身：被引用程序集中的 UnmanagedCallersOnly 不会被导出。
      由 SDK 提供、直接引用，因此项目内不再保留这个文件。
    -->
    <Compile Include="$(OrbedenSdkRoot)/Shared/GameAotExports.cs" />
  </ItemGroup>
  <!--
    包版本合同：Package.version 首行是包版本，第二行是所需的 RetainedGuiApi 主版本。
    引擎提供的主版本与它不等就构建失败，避免旧包配新引擎（或反过来）在运行期才炸。
  -->
  <Target Name="ValidateOrbedenUIPackage" BeforeTargets="CoreCompile" Condition="'$(OrbedenUIPackageRoot)' != ''">
    <Error Condition="!Exists('$(OrbedenUIPackageRoot)/Package.version')"
           Text="Orbeden.UI 包缺少 Package.version：$(OrbedenUIPackageRoot)" />
    <ReadLinesFromFile File="$(OrbedenUIPackageRoot)/Package.version">
      <Output TaskParameter="Lines" ItemName="_OrbedenUIPackageLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_OrbedenUIPackageLineSeq>@(_OrbedenUIPackageLines)</_OrbedenUIPackageLineSeq>
      <_OrbedenUIPackageApiMajor>$([System.Text.RegularExpressions.Regex]::Match('$(_OrbedenUIPackageLineSeq)', '^[0-9]+;[ \t]*([0-9]+)').Groups[1].Value)</_OrbedenUIPackageApiMajor>
    </PropertyGroup>
    <Error Condition="'$(_OrbedenUIPackageApiMajor)' == ''"
           Text="Package.version 需要两行：包版本与所需的 RetainedGuiApi 主版本。$(OrbedenUIPackageRoot)" />
    <Error Condition="'$(_OrbedenUIPackageApiMajor)' != '$(OrbedenRetainedGuiApiMajor)'"
           Text="Orbeden.UI 包需要 RetainedGuiApi 主版本 $(_OrbedenUIPackageApiMajor)，当前引擎提供 $(OrbedenRetainedGuiApiMajor)：$(OrbedenUIPackageRoot)" />
  </Target>
  <Target Name="GenerateOrbedenGameBindings" BeforeTargets="CoreCompile" Condition="'@(NativeVcxProject)' != ''">
    <Error Condition="!Exists('$(OrbedenSdkRoot)/Tools/OrbedenMetaGen/OrbedenMetaGen.dll')" Text="Orbeden SDK was not found. Build OrbedenCore to refresh the SDK." />
    <Exec Command="dotnet &quot;$(OrbedenSdkRoot)/Tools/OrbedenMetaGen/OrbedenMetaGen.dll&quot; &quot;$(OrbedenNativeSource)&quot; &quot;$(OrbedenBindingOutput)&quot; --game-module --bindings --namespace &quot;$(OrbedenBindingNamespace)&quot; --import &quot;$(OrbedenSdkRoot)/Native/Bindings.Manifest.json&quot;" />
    <ItemGroup>
      <Compile Include="$(OrbedenBindingOutput)/Bindings.Generated.cs" />
    </ItemGroup>
  </Target>
  <!-- Editor 代码单独编译；Player/AOT 不引用编辑器程序集。空工程也重建，以清除已删除扩展的旧 DLL。 -->
  <Target Name="BuildOrbedenEditorExtensions" AfterTargets="Build" Condition="'$(PublishAot)' != 'true' and '$(OrbedenBuildEditorExtensions)' != 'false'">
    <PropertyGroup>
      <OrbedenEditorAssembly>$(OrbedenSdkRoot)/Managed/Orbeden.Editor/Orbeden.Editor.dll</OrbedenEditorAssembly>
      <OrbedenEditorBindingNamespace Condition="'@(NativeVcxProject)' != ''">$(OrbedenBindingNamespace)</OrbedenEditorBindingNamespace>
    </PropertyGroup>
    <Error Condition="'@(OrbedenEditorSource)' != '' and !Exists('$(OrbedenEditorAssembly)')" Text="CustomEditor SDK is missing. Rebuild OrbedenEditor first." />
    <Exec UseUtf8Encoding="Always" Condition="Exists('$(OrbedenEditorAssembly)')" Command="dotnet build &quot;$(OrbedenSdkRoot)/Tools/OrbedenMetaGen/Orbeden.EditorExtensions.csproj&quot; -c $(Configuration) -o &quot;$(TargetDir).&quot; /p:GameBindingNamespace=&quot;$(OrbedenEditorBindingNamespace)&quot; /p:GameAssemblyName=&quot;$(AssemblyName)&quot; /p:GameAssemblyPath=&quot;$(TargetPath)&quot; /p:GameContentRoot=&quot;$(OrbedenContentRoot)&quot; /p:GameEditorPackageRoot=&quot;$(OrbedenUIEditorPackageRoot)&quot; /p:GameRuntimeAssembly=&quot;$(OrbedenSdkRoot)/Managed/OrbedenCore.CSharp/OrbedenCore.CSharp.dll&quot; /p:GameEditorAssembly=&quot;$(OrbedenEditorAssembly)&quot; /p:BaseIntermediateOutputPath=&quot;$(OrbedenProjectRoot)/Build/Editor/obj/&quot; /p:MSBuildProjectExtensionsPath=&quot;$(OrbedenProjectRoot)/Build/Editor/obj/&quot;" />
  </Target>
  <!--包源码接入。整包唯一来源已经在上面判定完毕，这里只负责把源码挂进编译。-->
  <Import Project="$(OrbedenUIPackageRoot)/Orbeden.UI.targets" Condition="'$(OrbedenUIPackageRoot)' != ''" />
  <!--
    用户手册随 SDK 刷新：先清空再铺，和 SDK 头文件发布同一套路，改名或删除后不留残页。
    旧 SDK 没有 Manual/ 时整段跳过，不会误删工程里已有的文档。
  -->
  <Target Name="RefreshOrbedenUserManual" AfterTargets="Build" Condition="Exists('$(OrbedenManualSource)')">
    <ItemGroup>
      <OrbedenManualFile Include="$(OrbedenManualSource)/**/*" />
    </ItemGroup>
    <RemoveDir Directories="$(OrbedenManualTarget)" />
    <MakeDir Directories="$(OrbedenManualTarget)" />
    <Copy SourceFiles="@(OrbedenManualFile)"
          DestinationFiles="@(OrbedenManualFile-&gt;'$(OrbedenManualTarget)/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
